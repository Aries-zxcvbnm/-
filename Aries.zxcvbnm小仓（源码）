/* ============================================================
   星空背景
   ============================================================ */
(function initStarfield() {
    const canvas = document.getElementById('starfield');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    let width, height, devicePixelRatio;
    const particles = [];
    const sandGrains = [];
    const PARTICLE_COUNT = 220;
    const mouse = { x: null, y: null, radius: 160 };
    let lastSandBurst = 0;

    function resize() {
        devicePixelRatio = window.devicePixelRatio || 1;
        width = canvas.clientWidth;
        height = canvas.clientHeight;
        canvas.width = width * devicePixelRatio;
        canvas.height = height * devicePixelRatio;
        ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    }

    class Particle {
        constructor() { this.reset(true); }
        reset(initial) {
            this.x = Math.random() * width;
            this.y = initial ? Math.random() * height : height + 10;
            this.size = Math.random() * 1.8 + 0.4;
            this.speedY = -(Math.random() * 0.4 + 0.1);
            this.speedX = (Math.random() - 0.5) * 0.3;
            this.alpha = Math.random() * 0.6 + 0.2;
            this.twinkle = Math.random() * Math.PI * 2;
            this.color = ['#7f7fd5', '#86a8e7', '#91eae4', '#ffffff'][Math.floor(Math.random() * 4)];
            this.sandColor = ['#b88945', '#c99d5b', '#dfbd7d', '#f0d9a4'][Math.floor(Math.random() * 4)];
            this.sandVelocity = Math.random() > 0.5 ? 0.25 : -0.25;
        }
        update() {
            if (document.body.dataset.theme === 'light') { this.updateSand(); return; }
            this.x += this.speedX;
            this.y += this.speedY;
            this.twinkle += 0.03;
            if (mouse.x !== null) {
                const dx = this.x - mouse.x;
                const dy = this.y - mouse.y;
                const distance = Math.hypot(dx, dy);
                if (distance < mouse.radius && distance > 0.01) {
                    const force = (mouse.radius - distance) / mouse.radius;
                    this.x += (dx / distance) * force * 2.5;
                    this.y += (dy / distance) * force * 2.5;
                }
            }
            if (this.y < -10 || this.x < -10 || this.x > width + 10) this.reset(false);
        }
        updateSand() {
            const dx = this.x - mouse.x;
            const dy = this.y - mouse.y;
            const distance = Math.hypot(dx, dy);
            this.sandVelocity += this.sandVelocity > 0 ? 0.012 : -0.012;
            this.sandVelocity = Math.max(-1.35, Math.min(1.35, this.sandVelocity));
            if (distance < mouse.radius && distance > 0.01) {
                const force = (mouse.radius - distance) / mouse.radius;
                this.sandVelocity += force * 0.12;
                this.x += (dx / distance) * force * 0.65;
            }
            this.y += this.sandVelocity;
            this.x += Math.sin(this.twinkle) * 0.08;
            this.twinkle += 0.018;
            if (this.y > height + 12) {
                this.y = height + 12;
                this.sandVelocity = -0.24 - Math.random() * 0.18;
            } else if (this.y < -12) {
                this.y = -12;
                this.sandVelocity = 0.24 + Math.random() * 0.18;
            }
            if (this.x < -12) this.x = width + 12;
            if (this.x > width + 12) this.x = -12;
        }
        draw() {
            if (document.body.dataset.theme === 'light') { this.drawSand(); return; }
            const alpha = this.alpha * (0.6 + 0.4 * Math.sin(this.twinkle));
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fillStyle = this.color;
            ctx.globalAlpha = alpha;
            ctx.shadowBlur = 8;
            ctx.shadowColor = this.color;
            ctx.fill();
            ctx.globalAlpha = 1;
            ctx.shadowBlur = 0;
        }
        drawSand() {
            const alpha = 0.28 + this.alpha * 0.65;
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size * 0.78, 0, Math.PI * 2);
            ctx.fillStyle = this.sandColor;
            ctx.globalAlpha = alpha;
            ctx.shadowBlur = 3;
            ctx.shadowColor = 'rgba(157, 111, 43, 0.24)';
            ctx.fill();
            ctx.globalAlpha = 1;
            ctx.shadowBlur = 0;
        }
    }

    function init() {
        resize();
        particles.length = 0;
        for (let i = 0; i < PARTICLE_COUNT; i++) particles.push(new Particle());
    }

    function drawLines() {
        if (document.body.dataset.theme === 'light') return;
        for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
                const dx = particles[i].x - particles[j].x;
                const dy = particles[i].y - particles[j].y;
                const distance = Math.hypot(dx, dy);
                if (distance < 110) {
                    ctx.beginPath();
                    ctx.moveTo(particles[i].x, particles[i].y);
                    ctx.lineTo(particles[j].x, particles[j].y);
                    ctx.strokeStyle = `rgba(134,168,231,${(1 - distance / 110) * 0.15})`;
                    ctx.lineWidth = 0.5;
                    ctx.stroke();
                }
            }
        }
    }

    function spawnSandBurst(x, y) {
        const now = performance.now();
        if (now - lastSandBurst < 70) return;
        lastSandBurst = now;

        const card = getCardAt(x, y);
        const spawnY = card ? card.top - 3 : y + 5;

        for (let i = 0; i < 3; i++) {
            sandGrains.push({
                x: x + (Math.random() - 0.5) * 18,
                y: spawnY + Math.random() * 5,
                vx: (Math.random() - 0.5) * 0.9,
                vy: -1.25 - Math.random() * 1.25,
                gravity: 0.035 + Math.random() * 0.02,
                size: 1 + Math.random() * 2.1,
                alpha: 0.72 + Math.random() * 0.28,
                life: 0,
                maxLife: 300 + Math.random() * 30,
                landed: false,
                landingY: null,
                color: ['#b77c31', '#d39b4a', '#edc477', '#f7dda2'][Math.floor(Math.random() * 4)]
            });
        }
    }

    function getCardAt(x, y) {
        const cards = document.querySelectorAll('.row');
        for (const card of cards) {
            const rect = card.getBoundingClientRect();
            if (x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom) return rect;
        }
        return null;
    }

    function getCardTopOnPath(x, y, nextY) {
        const cards = document.querySelectorAll('.row');
        let nearestTop = null;
        for (const card of cards) {
            const rect = card.getBoundingClientRect();
            if (x >= rect.left && x <= rect.right && y <= rect.top && nextY >= rect.top) {
                if (nearestTop === null || rect.top < nearestTop) nearestTop = rect.top;
            }
        }
        return nearestTop;
    }

    function drawSandGrains() {
        for (let i = sandGrains.length - 1; i >= 0; i--) {
            const grain = sandGrains[i];
            if (!grain.landed) {
                grain.vy += grain.gravity;
                const nextY = grain.y + grain.vy;
                const cardTop = getCardTopOnPath(grain.x, grain.y, nextY);
                if (cardTop !== null && grain.vy > 0) {
                    grain.landed = true;
                    grain.landingY = cardTop - grain.size;
                    grain.y = grain.landingY;
                    grain.vy = 0;
                    grain.vx *= 0.35;
                } else {
                    grain.x += grain.vx;
                    grain.y = nextY;
                }
            } else {
                grain.y = grain.landingY;
                grain.x += grain.vx;
                grain.vx *= 0.94;
            }
            grain.life += 1;
            const lifeProgress = grain.life / grain.maxLife;
            const fade = lifeProgress > 0.58 ? 1 - (lifeProgress - 0.58) / 0.42 : 1;
            const visibleAlpha = grain.alpha * Math.max(0, fade);

            if (grain.life >= grain.maxLife || grain.y > height + 20) {
                sandGrains.splice(i, 1);
                continue;
            }

            ctx.beginPath();
            ctx.arc(grain.x, grain.y, grain.size, 0, Math.PI * 2);
            ctx.fillStyle = grain.color;
            ctx.globalAlpha = visibleAlpha;
            ctx.shadowColor = 'rgba(127, 79, 22, .24)';
            ctx.shadowBlur = 4;
            ctx.fill();
            ctx.globalAlpha = 1;
            ctx.shadowBlur = 0;
        }
    }

    function drawSandWaves() {
        const time = performance.now() * 0.00022;
        const waveColors = [
            'rgba(255, 249, 213, .22)',
            'rgba(197, 143, 65, .10)',
            'rgba(255, 245, 194, .16)'
        ];
        for (let wave = 0; wave < 5; wave++) {
            const baseline = height * (0.16 + wave * 0.2);
            const amplitude = 7 + wave * 1.5;
            const frequency = 0.0045 + wave * 0.0004;
            const phase = time * (1 + wave * 0.12) + wave * 1.7;

            ctx.beginPath();
            ctx.moveTo(0, baseline);
            for (let x = 0; x <= width; x += 18) {
                const y = baseline + Math.sin(x * frequency + phase) * amplitude;
                ctx.lineTo(x, y);
            }
            ctx.lineTo(width, baseline + 42);
            ctx.lineTo(0, baseline + 42);
            ctx.closePath();
            ctx.fillStyle = waveColors[wave % waveColors.length];
            ctx.fill();
        }
    }

    function draw() {
        ctx.clearRect(0, 0, width, height);
        if (document.body.dataset.effects !== 'on') {
            requestAnimationFrame(draw);
            return;
        }
        if (document.body.dataset.theme === 'light') {
            drawSandWaves();
            drawSandGrains();
        } else {
            particles.forEach(particle => { particle.update(); particle.draw(); });
            drawLines();
        }
        requestAnimationFrame(draw);
    }

    window.addEventListener('resize', init);
    window.addEventListener('mousemove', e => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
        if (document.body.dataset.effects === 'on' && document.body.dataset.theme === 'light') {
            spawnSandBurst(mouse.x, mouse.y);
        }
    });
    window.addEventListener('mouseout', () => { mouse.x = null; mouse.y = null; });
    window.addEventListener('touchmove', e => {
        if (e.touches[0]) {
            mouse.x = e.touches[0].clientX;
            mouse.y = e.touches[0].clientY;
            if (document.body.dataset.effects === 'on' && document.body.dataset.theme === 'light') {
                spawnSandBurst(mouse.x, mouse.y);
            }
        }
    }, { passive: true });
    window.addEventListener('touchend', () => { mouse.x = null; mouse.y = null; });

    init();
    draw();
})();

render();

