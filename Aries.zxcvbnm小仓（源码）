function matchSoftware(item, kw) {
    if (!kw) return true;
    const target = normalize(kw);
    const nameText = normalize(item.name);
    const keywordText = [...item.keywords, ...(SOFTWARE_SEARCH_TAGS[item.name] || [])].map(normalize).join(' ');

    if (nameText.includes(target) || keywordText.includes(target)) return true;

    const letters = [...new Set(target.replace(/[^a-z0-9]/g, '').split('').filter(Boolean))];
    if (!letters.length) return false;

    return letters.every(letter => nameText.includes(letter) || keywordText.includes(letter));
}

function highlightMatchLetters(name, query) {
    if (!query) return name;
    const letters = [...new Set(normalize(query).replace(/[^a-z0-9]/g, '').split('').filter(Boolean))];
    if (!letters.length) return name;

    let html = '';
    for (const ch of name) {
        const lower = normalize(ch);
        html += letters.includes(lower) ? '<span class="match-letter">' + ch + '</span>' : ch;
    }
    return html;
}

function platformText(item) {
    const arr = [];
    if (item.win64 || item.win32) arr.push('Win');
    if (item.mac) arr.push('Mac');
    return arr.join(' · ');
}

function render() {
    const kw = currentKw;
    sortControl.hidden = currentTab === 'personal';
    personalPanel.hidden = currentTab !== 'personal';
    const candidates = currentTab === 'personal'
        ? (personalView === 'favorites' ? [...favoriteNames] : recentNames)
            .map(name => softwareByName.get(name)).filter(Boolean)
        : SOFTWARE_LIST.filter(item => currentTab === 'all' || item.cat === currentTab);
    const filtered = sortSoftware(candidates.filter(item => matchSoftware(item, kw)));
    const list = filtered;

    contentEl.innerHTML = '';
    if (!list.length) {
        emptyEl.style.display = 'block';
        resultTip.textContent = currentTab === 'personal'
            ? (personalView === 'favorites' ? '收藏 0 个软件' : '最近浏览 0 个软件')
            : '';
        return;
    }
    emptyEl.style.display = 'none';
    resultTip.textContent = currentTab === 'personal'
        ? (personalView === 'favorites' ? '收藏 ' : '最近浏览 ') + filtered.length + ' 个软件'
        : '共 ' + filtered.length + ' 个软件';

    const groups = {};
    if (currentTab === 'personal') groups.personal = list;
    else list.forEach(item => {
        if (!groups[item.cat]) groups[item.cat] = [];
        groups[item.cat].push(item);
    });

    const catOrder = currentTab === 'personal' ? ['personal'] : Object.keys(CAT_NAME);
    let animatedCardCount = 0;
    catOrder.forEach(cat => {
        if (!groups[cat]) return;
        const title = document.createElement('div');
        title.className = 'section-title';
        title.textContent = cat === 'personal'
            ? (personalView === 'favorites' ? '收藏' : '最近浏览')
            : CAT_NAME[cat];
        contentEl.appendChild(title);

        const box = document.createElement('div');
        box.className = 'list';

        groups[cat].forEach((item, index) => {
            const row = document.createElement('div');
            const ratingValue = Number.parseFloat(item.rating);
            const ratingClass = Number.isNaN(ratingValue)
                ? 'neutral'
                : ratingValue >= 4.6 ? 'good' : ratingValue >= 4.3 ? 'medium' : 'low';
            const shouldAnimate = animatedCardCount < 16;
            row.className = shouldAnimate ? 'row is-entering' : 'row';
            if (shouldAnimate) {
                row.style.animationDelay = Math.min(animatedCardCount * 24, 360) + 'ms';
                animatedCardCount++;
            }
            row.innerHTML =
                '<div>' +
                    '<span class="name"><span class="name-text">' + highlightMatchLetters(item.name, currentKw) +
                        '</span>' +
                        (item.recommend ? '<span class="badge">推荐</span>' : '') +
                    '</span>' +
                    '<span class="rating-dot ' + ratingClass + '" title="评分 ' + (item.rating || '暂无') + '"></span>' +
                    '<span class="platforms">' + platformText(item) + '</span>' +
                '</div>' +
                '<div class="row-actions"></div>';
            const actions = row.querySelector('.row-actions');
            const favoriteButton = document.createElement('button');
            const isFavorite = favoriteNames.has(item.name);
            favoriteButton.className = 'favorite-toggle' + (isFavorite ? ' active' : '');
            favoriteButton.type = 'button';
            favoriteButton.textContent = isFavorite ? '★' : '☆';
            favoriteButton.setAttribute('aria-pressed', String(isFavorite));
            favoriteButton.setAttribute('aria-label', isFavorite ? '取消收藏 ' + item.name : '收藏 ' + item.name);
            favoriteButton.addEventListener('click', event => {
                event.stopPropagation();
                toggleFavorite(item, favoriteButton);
            });
            actions.appendChild(favoriteButton);
            const actionLabel = document.createElement('div');
            actionLabel.className = 'action';
