    }

    function updateStatus() {
        if (game === 'chess') {
            const turnName = turn === 'white' ? '白方' : '黑方';
            const mySideName = mySide === 'white' ? '白方' : '黑方';
            setStatus(turnName + '走棋 · 你执' + mySideName + ' · 双人轮流');
        } else if (game === 'gomoku') {
            const turnName = turn === 'black' ? '黑方' : '白方';
            const mySideName = mySide === 'black' ? '黑方' : '白方';
            setStatus(turnName + '落子 · 你执' + mySideName + ' · 双人轮流');
        } else if (game === 'go') {
            const turnName = turn === 'black' ? '黑方' : '白方';
            setStatus('黑棋 ' + goUsed.black + '子 / 剩' + (181 - goUsed.black) + ' · 提' + goCaptures.black
                + ' | 白棋 ' + goUsed.white + '子 / 剩' + (181 - goUsed.white) + ' · 提' + goCaptures.white
                + ' | ' + turnName + '落子');
        } else {
            setStatus('轮到 ' + turn + ' 落子 · 你选 ' + mySide + ' · 双人轮流');
        }
    }

    function makePiece(color, type) { return { color, type }; }

    function resetChess() {
        const backRank = ['r', 'n', 'b', 'q', 'k', 'b', 'n', 'r'];
        chessState = Array.from({ length: 8 }, () => Array(8).fill(null));
        for (let col = 0; col < 8; col++) {
            chessState[0][col] = makePiece('black', backRank[col]);
            chessState[1][col] = makePiece('black', 'p');
            chessState[6][col] = makePiece('white', 'p');
            chessState[7][col] = makePiece('white', backRank[col]);
        }
        turn = 'white';
        selected = null;
        lastMove = null;
        gameOver = false;
        renderChess();
        updateStatus();
    }

    function insideChess(row, col) { return row >= 0 && row < 8 && col >= 0 && col < 8; }

    function chessMoveAllowed(fromRow, fromCol, toRow, toCol) {
        const piece = chessState[fromRow][fromCol];
        const target = chessState[toRow][toCol];
        if (!piece || !insideChess(toRow, toCol) || (target && target.color === piece.color)) return false;
        const rowDelta = toRow - fromRow;
        const colDelta = toCol - fromCol;
        const absRow = Math.abs(rowDelta);
        const absCol = Math.abs(colDelta);
        if (piece.type === 'p') {
            const direction = piece.color === 'white' ? -1 : 1;
            const startRow = piece.color === 'white' ? 6 : 1;
            if (colDelta === 0 && !target && rowDelta === direction) return true;
            if (colDelta === 0 && !target && fromRow === startRow && rowDelta === direction * 2 && !chessState[fromRow + direction][fromCol]) return true;
            return absCol === 1 && rowDelta === direction && !!target;
        }
        if (piece.type === 'n') return (absRow === 2 && absCol === 1) || (absRow === 1 && absCol === 2);
        if (piece.type === 'k') return Math.max(absRow, absCol) === 1;
        const diagonal = absRow === absCol && absRow > 0;
        const straight = (rowDelta === 0) !== (colDelta === 0);
        if (piece.type === 'b' && !diagonal) return false;
        if (piece.type === 'r' && !straight) return false;
        if (piece.type === 'q' && !diagonal && !straight) return false;
        if (!['b', 'r', 'q'].includes(piece.type)) return false;
        const rowStep = Math.sign(rowDelta);
        const colStep = Math.sign(colDelta);
        let row = fromRow + rowStep;
        let col = fromCol + colStep;
        while (row !== toRow || col !== toCol) {
            if (chessState[row][col]) return false;
            row += rowStep;
            col += colStep;
        }
        return true;
    }

    function renderChess() {
        chessBoard.replaceChildren();
        for (let viewRow = 0; viewRow < 8; viewRow++) {
            for (let viewCol = 0; viewCol < 8; viewCol++) {
                const row = mySide === 'white' ? viewRow : 7 - viewRow;
                const col = mySide === 'white' ? viewCol : 7 - viewCol;
                const piece = chessState[row][col];
                const square = document.createElement('button');
                square.type = 'button';
                square.className = 'chess-square ' + ((row + col) % 2 ? 'dark' : 'light');
                if (selected && selected.row === row && selected.col === col) square.classList.add('selected');
                if (lastMove && ((lastMove.fromRow === row && lastMove.fromCol === col) || (lastMove.toRow === row && lastMove.toCol === col))) square.classList.add('last-move');
                square.textContent = piece ? pieceSymbols[piece.color][piece.type] : '';
                square.setAttribute('aria-label', (piece ? piece.color + ' ' + piece.type : 'empty') + ' ' + (8 - row) + ',' + (col + 1));
                square.addEventListener('click', () => playChessSquare(row, col));
                chessBoard.appendChild(square);
            }
        }
    }

    function playChessSquare(row, col) {
        if (gameOver) return;
        const piece = chessState[row][col];
        if (!selected) {
            if (piece && piece.color === turn) { selected = { row, col }; renderChess(); }
            return;
        }
        if (piece && piece.color === turn) { selected = { row, col }; renderChess(); return; }
        if (!chessMoveAllowed(selected.row, selected.col, row, col)) return;
        const movingPiece = chessState[selected.row][selected.col];
        const capturedKing = piece && piece.type === 'k';
        chessState[row][col] = movingPiece;
        chessState[selected.row][selected.col] = null;
        if (movingPiece.type === 'p' && (row === 0 || row === 7)) movingPiece.type = 'q';
        lastMove = { fromRow: selected.row, fromCol: selected.col, toRow: row, toCol: col };
        selected = null;
        if (capturedKing) {
            gameOver = true;
            renderChess();
            setStatus((movingPiece.color === 'white' ? '白方' : '黑方') + '获胜');
            return;
        }
        turn = turn === 'white' ? 'black' : 'white';
        renderChess();
        updateStatus();
    }

    function drawGomoku() {
        gomokuContext.clearRect(0, 0, canvasSize, canvasSize);
        gomokuContext.fillStyle = '#e5bd7d';
        gomokuContext.fillRect(0, 0, canvasSize, canvasSize);
        gomokuContext.strokeStyle = 'rgba(82, 55, 27, .64)';
        gomokuContext.lineWidth = 1;
        for (let index = 0; index < boardSize; index++) {
            const point = boardPadding + index * boardStep;
            gomokuContext.beginPath();
            gomokuContext.moveTo(boardPadding, point);
            gomokuContext.lineTo(canvasSize - boardPadding, point);
            gomokuContext.stroke();
            gomokuContext.beginPath();
            gomokuContext.moveTo(point, boardPadding);
            gomokuContext.lineTo(point, canvasSize - boardPadding);
            gomokuContext.stroke();
        }
        for (let row = 0; row < boardSize; row++) {
            for (let col = 0; col < boardSize; col++) {
                const stone = gomokuState[row][col];
                if (!stone) continue;
                const x = boardPadding + col * boardStep;
                const y = boardPadding + row * boardStep;
                gomokuContext.beginPath();
                gomokuContext.arc(x, y, boardStep * 0.42, 0, Math.PI * 2);
                gomokuContext.fillStyle = stone === 'black' ? '#20232a' : '#fff';
                gomokuContext.fill();
                if (stone === 'white') {
                    gomokuContext.strokeStyle = 'rgba(0, 0, 0, .35)';
                    gomokuContext.stroke();
                }
            }
        }
    }

    function resetGomoku() {
        gomokuState = Array.from({ length: boardSize }, () => Array(boardSize).fill(null));
        turn = 'black';
        gameOver = false;
        drawGomoku();
        updateStatus();
    }

    function drawGo() {
        const gridSize = 19;
        const padding = 20;
        const step = (canvasSize - padding * 2) / (gridSize - 1);
        goContext.clearRect(0, 0, canvasSize, canvasSize);
        goContext.fillStyle = '#d7ad65';
        goContext.fillRect(0, 0, canvasSize, canvasSize);
        goContext.strokeStyle = 'rgba(82, 55, 27, .7)';
        goContext.lineWidth = 1;
        for (let index = 0; index < gridSize; index++) {
            const point = padding + index * step;
            goContext.beginPath();
            goContext.moveTo(padding, point);
            goContext.lineTo(canvasSize - padding, point);
            goContext.stroke();
            goContext.beginPath();
            goContext.moveTo(point, padding);
            goContext.lineTo(point, canvasSize - padding);
            goContext.stroke();
        }
        for (const row of [3, 9, 15]) {
            for (const col of [3, 9, 15]) {
                goContext.beginPath();
                goContext.arc(padding + col * step, padding + row * step, 3, 0, Math.PI * 2);
                goContext.fillStyle = 'rgba(82, 55, 27, .8)';
                goContext.fill();
            }
        }
        for (let row = 0; row < gridSize; row++) {
            for (let col = 0; col < gridSize; col++) {
                const stone = goState[row][col];
                if (!stone) continue;
                goContext.beginPath();
                goContext.arc(padding + col * step, padding + row * step, step * .44, 0, Math.PI * 2);
                goContext.fillStyle = stone === 'black' ? '#20232a' : '#fff';
                goContext.fill();
                goContext.strokeStyle = 'rgba(0, 0, 0, .38)';
                goContext.stroke();
            }
        }
    }

    function resetGo() {
        goState = Array.from({ length: 19 }, () => Array(19).fill(null));
        goCaptures = { black: 0, white: 0 };
        goUsed = { black: 0, white: 0 };
        goPasses = 0;
        previousGoPosition = null;
        turn = 'black';
        gameOver = false;
        drawGo();
        updateStatus();
    }

    function findGoGroup(state, startRow, startCol) {
        const color = state[startRow][startCol];
        const stack = [[startRow, startCol]];
        const visited = new Set();
        const liberties = new Set();
        const stones = [];
        while (stack.length) {
            const [row, col] = stack.pop();
            const key = row + ',' + col;
            if (visited.has(key)) continue;
            visited.add(key);
            stones.push([row, col]);
            for (const [rowDelta, colDelta] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
                const nextRow = row + rowDelta;
                const nextCol = col + colDelta;
                if (nextRow < 0 || nextRow >= 19 || nextCol < 0 || nextCol >= 19) continue;
                if (!state[nextRow][nextCol]) liberties.add(nextRow + ',' + nextCol);
                else if (state[nextRow][nextCol] === color && !visited.has(nextRow + ',' + nextCol)) stack.push([nextRow, nextCol]);
            }
        }
        return { stones, liberties };
    }

    function goPositionKey(state) {
        return state.map(row => row.map(stone => stone === 'black' ? 'b' : stone === 'white' ? 'w' : '.').join('')).join('');
    }

    function playGo(row, col) {
        if (gameOver || goState[row][col] || goUsed[turn] >= 181) return;
        const color = turn;
        const opponent = color === 'black' ? 'white' : 'black';
        const candidate = goState.map(line => line.slice());
        candidate[row][col] = color;
        let captured = 0;
        const examined = new Set();

        for (const [rowDelta, colDelta] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
            const nextRow = row + rowDelta;
            const nextCol = col + colDelta;
            if (nextRow < 0 || nextRow >= 19 || nextCol < 0 || nextCol >= 19 || candidate[nextRow][nextCol] !== opponent) continue;
            if (examined.has(nextRow + ',' + nextCol)) continue;
            const group = findGoGroup(candidate, nextRow, nextCol);
            group.stones.forEach(([stoneRow, stoneCol]) => examined.add(stoneRow + ',' + stoneCol));
            if (group.liberties.size) continue;
            for (const [stoneRow, stoneCol] of group.stones) {
                candidate[stoneRow][stoneCol] = null;
                captured++;
            }
        }

        if (!findGoGroup(candidate, row, col).liberties.size) return;
        const candidateKey = goPositionKey(candidate);
        if (candidateKey === previousGoPosition) return;

        previousGoPosition = goPositionKey(goState);
        goState = candidate;
        goCaptures[color] += captured;
        goUsed[color]++;
        goPasses = 0;
        turn = opponent;
        drawGo();
        updateStatus();
    }

    function passGo() {
        if (gameOver) return;
        goPasses++;
        if (goPasses === 2) {
            gameOver = true;
            if (goCaptures.black === goCaptures.white) setStatus('双方连续停一手，提子数相同，平局');
            else setStatus('双方连续停一手，' + (goCaptures.black > goCaptures.white ? '黑方' : '白方') + '以更多提子获胜');
            return;
        }
        turn = turn === 'black' ? 'white' : 'black';
        updateStatus();
    }

    function countGomoku(row, col, rowStep, colStep, color) {
        let count = 0;
        let nextRow = row + rowStep;
        let nextCol = col + colStep;
        while (nextRow >= 0 && nextRow < boardSize && nextCol >= 0 && nextCol < boardSize && gomokuState[nextRow][nextCol] === color) {
            count++;
            nextRow += rowStep;
            nextCol += colStep;
        }
        return count;
    }

    gomokuCanvas.addEventListener('click', event => {
        if (gameOver) return;
        const rect = gomokuCanvas.getBoundingClientRect();
        const x = (event.clientX - rect.left) * canvasSize / rect.width;
        const y = (event.clientY - rect.top) * canvasSize / rect.height;
        const col = Math.round((x - boardPadding) / boardStep);
        const row = Math.round((y - boardPadding) / boardStep);
        if (row < 0 || row >= boardSize || col < 0 || col >= boardSize || gomokuState[row][col]) return;
        const color = turn;
        gomokuState[row][col] = color;
        drawGomoku();
        const axes = [[1, 0], [0, 1], [1, 1], [1, -1]];
        const won = axes.some(([dr, dc]) => 1 + countGomoku(row, col, dr, dc, color) + countGomoku(row, col, -dr, -dc, color) >= 5);
        if (won) {
            gameOver = true;
            setStatus((color === 'black' ? '黑方' : '白方') + '连成五子，获胜');
            return;
        }
        turn = color === 'black' ? 'white' : 'black';
        updateStatus();
    });

    goCanvas.addEventListener('click', event => {
        const rect = goCanvas.getBoundingClientRect();
        const padding = 20;
        const step = (canvasSize - padding * 2) / 18;
        const x = (event.clientX - rect.left) * canvasSize / rect.width;
        const y = (event.clientY - rect.top) * canvasSize / rect.height;
        const col = Math.round((x - padding) / step);
        const row = Math.round((y - padding) / step);
        if (row >= 0 && row < 19 && col >= 0 && col < 19) playGo(row, col);
    });
    goPassButton.addEventListener('click', passGo);

    function resetTtt() {
        tttState = Array(9).fill('');
        turn = 'X';
        gameOver = false;
        renderTtt();
        updateStatus();
    }

    function renderTtt() {
        tttBoard.replaceChildren();
        tttState.forEach((mark, index) => {
            const cell = document.createElement('button');
            cell.type = 'button';
            cell.className = 'ttt-cell';
            cell.textContent = mark;
            cell.disabled = !!mark || gameOver;
            cell.setAttribute('aria-label', mark ? mark : '空格 ' + (index + 1));
            cell.addEventListener('click', () => playTtt(index));
            tttBoard.appendChild(cell);
        });
    }

    function playTtt(index) {
        if (gameOver || tttState[index]) return;
        tttState[index] = turn;
        const lines = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]];
        if (lines.some(line => line.every(cell => tttState[cell] === turn))) {
            gameOver = true;
            renderTtt();
            setStatus(turn + ' 获胜');
            return;
        }
        if (tttState.every(Boolean)) {
            gameOver = true;
            renderTtt();
            setStatus('平局');
            return;
        }
        turn = turn === 'X' ? 'O' : 'X';
        renderTtt();
        updateStatus();
    }

    function resetGame() {
        Object.entries(boardElements).forEach(([name, element]) => { element.hidden = name !== game; });
        goPassButton.hidden = game !== 'go';
        if (game === 'chess') resetChess();
        else if (game === 'gomoku') resetGomoku();
        else if (game === 'go') resetGo();
        else resetTtt();
    }

    tabs.forEach(tab => tab.addEventListener('click', () => setGame(tab.dataset.game)));
    sideButtons.forEach(button => button.addEventListener('click', () => {
        if (button.hidden) return;
        sideButtons.forEach(option => option.classList.toggle('active', option === button));
    }));
    beginButton.addEventListener('click', () => {
        const chosen = sideButtons.find(button => !button.hidden && button.classList.contains('active'));
        mySide = chosen ? chosen.dataset.side : (game === 'ttt' ? 'X' : 'white');
        setup.hidden = true;
        view.hidden = false;
        resetGame();
    });
    restartButton.addEventListener('click', resetGame);
    closeButton.addEventListener('click', () => closeEgg(mask));
    mask.addEventListener('click', event => { if (event.target === mask) closeButton.click(); });
    window.addEventListener('keydown', event => {
        if (mask.classList.contains('show') && event.key === 'Escape') {
            event.preventDefault();
            closeButton.click();
        }
    });

    return {
        open(initialGame) {
            setGame(initialGame || 'chess');
            replayEggDrop(mask);
        }
    };
})();

const XiangqiPuzzle = (function () {
    const mask = document.getElementById('xiangqiMask');
    const board = document.getElementById('xiangqiBoard');
    const status = document.getElementById('xiangqiStatus');
    const closeButton = document.getElementById('xiangqiClose');
    const restartButton = document.getElementById('xiangqiRestart');
    const symbols = {
        red: { rook: '車', horse: '馬', elephant: '相', advisor: '仕', general: '帅', cannon: '炮', soldier: '兵' },
        black: { rook: '車', horse: '馬', elephant: '象', advisor: '士', general: '将', cannon: '炮', soldier: '卒' }
    };
    const names = {
        red: { rook: '红车', horse: '红马', elephant: '红相', advisor: '红仕', general: '红帅', cannon: '红炮', soldier: '红兵' },
        black: { rook: '黑车', horse: '黑马', elephant: '黑象', advisor: '黑士', general: '黑将', cannon: '黑炮', soldier: '黑卒' }
    };
    let pieces = [];
    let selectedKind = null;
    let turn = 'red';
    let gameOver = false;

    function makeStandardLayout() {
        const layout = Array(90).fill(null);
        const slots = [];
        const backRank = ['rook', 'horse', 'elephant', 'advisor', 'general', 'advisor', 'elephant', 'horse', 'rook'];
        for (let col = 0; col < 9; col++) {
            slots.push({ index: col, owner: 'black', assumedType: backRank[col] });
            slots.push({ index: 81 + col, owner: 'red', assumedType: backRank[col] });
        }
        for (const col of [1, 7]) {
            slots.push({ index: 18 + col, owner: 'black', assumedType: 'cannon' });
            slots.push({ index: 63 + col, owner: 'red', assumedType: 'cannon' });
        }
        for (const col of [0, 2, 4, 6, 8]) {
            slots.push({ index: 27 + col, owner: 'black', assumedType: 'soldier' });
            slots.push({ index: 54 + col, owner: 'red', assumedType: 'soldier' });
        }

        const hiddenPieces = [];
        for (const side of ['red', 'black']) {
            for (const type of ['rook', 'rook', 'horse', 'horse', 'elephant', 'elephant', 'advisor', 'advisor', 'cannon', 'cannon', 'soldier', 'soldier', 'soldier', 'soldier', 'soldier']) {
                hiddenPieces.push({ side, type });
            }
        }
        layout[4] = { side: 'black', type: 'general', owner: 'black', assumedType: 'general', revealed: false };
        layout[85] = { side: 'red', type: 'general', owner: 'red', assumedType: 'general', revealed: false };
        for (let index = hiddenPieces.length - 1; index > 0; index--) {
            const swapIndex = Math.floor(Math.random() * (index + 1));
            [hiddenPieces[index], hiddenPieces[swapIndex]] = [hiddenPieces[swapIndex], hiddenPieces[index]];
        }
        let hiddenIndex = 0;
        slots.forEach(slot => {
            if (slot.assumedType === 'general') return;
            layout[slot.index] = { ...hiddenPieces[hiddenIndex++], ...slot, revealed: false };
        });
        return layout;
    }

    function pieceElement(piece, index) {
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'xiangqi-cell';
        if (piece) {
            if (piece.revealed) {
                cell.textContent = symbols[piece.side][piece.type];
                cell.classList.add(piece.side === 'red' ? 'red-piece' : 'black-piece');
                cell.setAttribute('aria-label', names[piece.side][piece.type]);
            } else {
                cell.classList.add('hidden-piece');
                cell.textContent = '';
                cell.setAttribute('aria-label', '未翻开的棋子');
            }
            if (selectedKind === index) cell.classList.add('selected');
        }
        cell.addEventListener('click', () => playSquare(index));
        return cell;
    }

    function render() {
        board.replaceChildren(...pieces.map((piece, index) => pieceElement(piece, index)));
    }

    function inPalace(side, row, col) {
        return col >= 3 && col <= 5 && (side === 'red' ? row >= 7 && row <= 9 : row >= 0 && row <= 2);
    }

    function countBetween(fromRow, fromCol, toRow, toCol, state) {
        const rowStep = Math.sign(toRow - fromRow);
        const colStep = Math.sign(toCol - fromCol);
        let count = 0;
        for (let row = fromRow + rowStep, col = fromCol + colStep; row !== toRow || col !== toCol; row += rowStep, col += colStep) {
            if (state[row * 9 + col]) count++;
        }
        return count;
    }

    function canMove(state, fromIndex, toIndex, ignoreOwnership = false) {
        const piece = state[fromIndex];
        const target = state[toIndex];
        if (!piece || fromIndex === toIndex || (!ignoreOwnership && target && target.owner === piece.owner)) return false;
        const fromRow = Math.floor(fromIndex / 9);
        const fromCol = fromIndex % 9;
        const toRow = Math.floor(toIndex / 9);
        const toCol = toIndex % 9;
        const rowDelta = toRow - fromRow;
        const colDelta = toCol - fromCol;
        const absRow = Math.abs(rowDelta);
        const absCol = Math.abs(colDelta);
        const between = countBetween(fromRow, fromCol, toRow, toCol, state);
        const moveType = piece.revealed ? piece.type : piece.assumedType;
        const moveSide = piece.revealed ? piece.side : piece.owner;

        if (moveType === 'rook') return (rowDelta === 0 || colDelta === 0) && between === 0;
        if (moveType === 'cannon') return (rowDelta === 0 || colDelta === 0) && between === (target ? 1 : 0);
        if (moveType === 'horse') {
            if (!((absRow === 2 && absCol === 1) || (absRow === 1 && absCol === 2))) return false;
            const legRow = fromRow + (absRow === 2 ? Math.sign(rowDelta) : 0);
            const legCol = fromCol + (absCol === 2 ? Math.sign(colDelta) : 0);
            return !state[legRow * 9 + legCol];
        }
        if (moveType === 'elephant') {
            if (absRow !== 2 || absCol !== 2 || (moveSide === 'red' ? toRow < 5 : toRow > 4)) return false;
            return !state[(fromRow + rowDelta / 2) * 9 + fromCol + colDelta / 2];
        }
        if (moveType === 'advisor') return absRow === 1 && absCol === 1 && inPalace(moveSide, toRow, toCol);
        if (moveType === 'general') {
            const flyingCapture = target && target.assumedType === 'general' && fromCol === toCol && between === 0;
            return flyingCapture || (absRow + absCol === 1 && inPalace(moveSide, toRow, toCol));
        }
        if (moveType === 'soldier') {
            const forward = moveSide === 'red' ? -1 : 1;
            const crossedRiver = moveSide === 'red' ? fromRow <= 4 : fromRow >= 5;
            return (rowDelta === forward && colDelta === 0)
                || (crossedRiver && rowDelta === 0 && absCol === 1);
        }
        return false;
    }

    function isInCheck(side, state) {
        const kingIndex = state.findIndex(piece => piece && piece.side === side && piece.type === 'general');
        if (kingIndex < 0) return false;
        const attackerSide = side === 'red' ? 'black' : 'red';
        return state.some((piece, index) => piece && piece.revealed && piece.side === attackerSide && canMove(state, index, kingIndex, true));
    }

    function playSquare(index) {
        if (gameOver) return;
        const piece = pieces[index];
        if (selectedKind === null) {
            if (piece && piece.owner === turn) {
                selectedKind = index;
                render();
            }
            return;
        }

        if (index === selectedKind) {
            selectedKind = null;
            render();
            return;
        }
        if (piece && piece.owner === turn) {
            selectedKind = index;
            render();
            return;
        }

        const source = pieces[selectedKind];
        const sourceName = names[source.side][source.type];
        if (!canMove(pieces, selectedKind, index)) {
            source.revealed = true;
            selectedKind = null;
            status.textContent = '翻开是' + sourceName + '，这步走不了';
            render();
            return;
        }

        const nextState = pieces.slice();
        nextState[index] = { ...source, revealed: true };
        nextState[selectedKind] = null;
        const captured = pieces[index];
        pieces = nextState;
        selectedKind = null;
        if (captured && captured.type === 'general') {
            gameOver = true;
            status.textContent = (turn === 'red' ? '红方' : '黑方') + '吃掉' + names[captured.side].general + '，获胜';
            render();
            return;
        }

        const nextTurn = turn === 'red' ? 'black' : 'red';
        turn = nextTurn;
        const checkedSides = ['red', 'black'].filter(side => isInCheck(side, pieces));
        status.textContent = sourceName + '移动并翻开 · ' + (checkedSides.length
            ? checkedSides.map(side => (side === 'red' ? '红方' : '黑方') + '被将军').join('、')
            : '轮到' + (nextTurn === 'red' ? '红方' : '黑方'));
        render();
    }

    function reset() {
        pieces = makeStandardLayout();
        turn = 'red';
        gameOver = false;
        selectedKind = null;
        status.textContent = '红方先行 · 棋子身份已隐藏';
        render();
    }

    function close() {
        mask.classList.remove('show');
        document.body.classList.remove('egg-locked');
    }

    closeButton.addEventListener('click', close);
    restartButton.addEventListener('click', reset);
    mask.addEventListener('click', event => { if (event.target === mask) close(); });
    window.addEventListener('keydown', event => {
        if (mask.classList.contains('show') && event.key === 'Escape') {
            event.preventDefault();
            close();
        }
    });

    return {
        open() {
            reset();
            document.getElementById('searchInput').blur();
            replayEggDrop(mask);
        }
    };
})();
</script>

