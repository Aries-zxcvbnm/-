    const COLS = 20, ROWS = 20, CELL = 24;
    const W = COLS * CELL, H = ROWS * CELL;
    let ctx = setupCanvas(canvas, W, H);

    let snake, dir, nextDir, food, score, stepMs, acc, lastTime, running, paused, rafId = null;
    let best = parseInt(localStorage.getItem('aries-snake-best') || '0', 10) || 0;
    bestEl.textContent = String(best);

    function hexToRgb(hex) {
        const v = parseInt(hex.slice(1), 16);
        return { r: (v >> 16) & 255, g: (v >> 8) & 255, b: v & 255 };
    }

    function mixColor(a, b, t) {
        const pa = hexToRgb(a), pb = hexToRgb(b);
        return 'rgb(' + Math.round(pa.r + (pb.r - pa.r) * t) + ',' +
            Math.round(pa.g + (pb.g - pa.g) * t) + ',' +
            Math.round(pa.b + (pb.b - pa.b) * t) + ')';
    }

    function roundRect(c, x, y, w, h, r) {
        c.beginPath();
        c.moveTo(x + r, y);
        c.arcTo(x + w, y, x + w, y + h, r);
        c.arcTo(x + w, y + h, x, y + h, r);
        c.arcTo(x, y + h, x, y, r);
        c.arcTo(x, y, x + w, y, r);
        c.closePath();
    }

    function placeFood() {
        const occupied = new Set(snake.map(s => s.x + ',' + s.y));
        const free = [];
        for (let y = 0; y < ROWS; y++)
            for (let x = 0; x < COLS; x++)
                if (!occupied.has(x + ',' + y)) free.push({ x, y });
        food = free.length ? free[(Math.random() * free.length) | 0] : null;
    }

    function draw() {
        const isDark = document.body.dataset.theme === 'dark';
        ctx.clearRect(0, 0, W, H);
        ctx.fillStyle = isDark ? '#0e131b' : '#fdf8ec';
        ctx.fillRect(0, 0, W, H);

        ctx.strokeStyle = isDark ? 'rgba(255,255,255,.05)' : 'rgba(120,90,40,.09)';
        ctx.lineWidth = 1;
        for (let i = 1; i < COLS; i++) {
            ctx.beginPath(); ctx.moveTo(i * CELL + .5, 0); ctx.lineTo(i * CELL + .5, H); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(0, i * CELL + .5); ctx.lineTo(W, i * CELL + .5); ctx.stroke();
        }

        if (food) {
            const fx = food.x * CELL + CELL / 2;
            const fy = food.y * CELL + CELL / 2;
            const pulse = 0.86 + 0.14 * Math.sin(performance.now() / 220);
            ctx.beginPath();
            ctx.arc(fx, fy, CELL * 0.34 * pulse, 0, Math.PI * 2);
            ctx.fillStyle = '#ff5a5f';
            ctx.shadowColor = 'rgba(255,90,95,.7)';
            ctx.shadowBlur = 16;
            ctx.fill();
            ctx.shadowBlur = 0;
        }

        const headColor = isDark ? '#6ea8ff' : '#2f6bff';
        const tailColor = isDark ? '#3d6bb5' : '#8fb6ff';
        const n = Math.max(1, snake.length - 1);

        snake.forEach((seg, i) => {
            const t = i / n;
            const pad = i === 0 ? 1.5 : 2.5;
            roundRect(ctx, seg.x * CELL + pad, seg.y * CELL + pad, CELL - pad * 2, CELL - pad * 2, i === 0 ? 7 : 5);
            ctx.fillStyle = i === 0 ? headColor : mixColor(headColor, tailColor, t);
            ctx.globalAlpha = i === 0 ? 1 : 0.92 - t * 0.28;
            ctx.fill();
            ctx.globalAlpha = 1;
        });

        if (snake.length) {
            const head = snake[0];
            const cx = head.x * CELL + CELL / 2;
            const cy = head.y * CELL + CELL / 2;
            const ox = dir.y !== 0 ? 5 : 0;
            const oy = dir.x !== 0 ? 5 : 0;
            const fx = dir.x * 4, fy = dir.y * 4;
            ctx.fillStyle = '#ffffff';
            ctx.beginPath(); ctx.arc(cx + fx + ox, cy + fy + oy, 2.2, 0, Math.PI * 2); ctx.fill();
            ctx.beginPath(); ctx.arc(cx + fx - ox, cy + fy - oy, 2.2, 0, Math.PI * 2); ctx.fill();
        }
    }

    function reset() {
        snake = [{ x: 9, y: 10 }, { x: 8, y: 10 }, { x: 7, y: 10 }];
        dir = { x: 1, y: 0 };
        nextDir = { x: 1, y: 0 };
        score = 0; stepMs = 150; acc = 0; lastTime = 0;
        running = false; paused = false;
        scoreEl.textContent = '0';
        placeFood();
        draw();
    }

    function endGame() {
        running = false; paused = false;
        draw();
        if (score > best) {
            best = score;
            localStorage.setItem('aries-snake-best', String(best));
            bestEl.textContent = String(best);
        }
        showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
            '游戏结束', '本局得分 ' + score + ' · 最高 ' + best, '再来一局');
    }

    function step() {
        dir = nextDir;
        const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };

        if (head.x < 0 || head.x >= COLS || head.y < 0 || head.y >= ROWS) { endGame(); return; }
        for (let i = 0; i < snake.length - 1; i++) {
            if (snake[i].x === head.x && snake[i].y === head.y) { endGame(); return; }
        }

        snake.unshift(head);
        if (food && head.x === food.x && head.y === food.y) {
            score += 10;
            scoreEl.textContent = String(score);
            stepMs = Math.max(65, stepMs - 4);
            placeFood();
        } else {
            snake.pop();
        }
    }

    function loop(time) {
        if (!running) { rafId = null; return; }
        if (!lastTime) lastTime = time;
        let dt = time - lastTime;
        lastTime = time;
        if (dt > 200) dt = 200;

        if (!paused) {
            acc += dt;
            while (acc >= stepMs) {
                acc -= stepMs;
                step();
                if (!running) break;
            }
        }
        if (!running) { rafId = null; return; }
        draw();
        rafId = requestAnimationFrame(loop);
    }

    function start() {
        reset();
        hideEggOverlay(overlayEl);
        running = true; paused = false; lastTime = 0; acc = 0;
        if (rafId === null) rafId = requestAnimationFrame(loop);
    }

    function togglePause() {
        if (!running) return;
        paused = !paused;
        if (paused) showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn, '已暂停', '按空格或点击按钮继续', '继续游戏');
        else hideEggOverlay(overlayEl);
    }

    startBtn.addEventListener('click', () => {
        if (running && paused) { paused = false; hideEggOverlay(overlayEl); return; }
        start();
    });

    closeBtn.addEventListener('click', () => {
        running = false; paused = false;
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
        closeEgg(mask);
    });

    mask.addEventListener('click', e => { if (e.target === mask) closeBtn.click(); });

    window.addEventListener('keydown', e => {
        if (!mask.classList.contains('show')) return;
        if (e.key === 'Escape') { e.preventDefault(); closeBtn.click(); return; }
        if (e.key === ' ' || e.key === 'Spacebar' || e.code === 'Space') {
            e.preventDefault();
            if (!running) start(); else togglePause();
            return;
        }
        let nd = null;
        const k = (e.key || '').toLowerCase();
        if (e.key === 'ArrowUp' || k === 'w') nd = { x: 0, y: -1 };
        else if (e.key === 'ArrowDown' || k === 's') nd = { x: 0, y: 1 };
        else if (e.key === 'ArrowLeft' || k === 'a') nd = { x: -1, y: 0 };
        else if (e.key === 'ArrowRight' || k === 'd') nd = { x: 1, y: 0 };
        if (!nd) return;
        e.preventDefault();
        if (!running) start();
        if (nd.x === -dir.x && nd.y === -dir.y) return;
        nextDir = nd;
    });

    let touchStart = null;
    canvas.addEventListener('touchstart', e => {
        if (e.touches[0]) touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }, { passive: true });
    canvas.addEventListener('touchend', e => {
        if (!touchStart) return;
        const t = e.changedTouches[0];
        if (!t) return;
        const dx = t.clientX - touchStart.x;
        const dy = t.clientY - touchStart.y;
        touchStart = null;
        if (Math.abs(dx) < 20 && Math.abs(dy) < 20) return;
        let nd;
        if (Math.abs(dx) > Math.abs(dy)) nd = { x: dx > 0 ? 1 : -1, y: 0 };
        else nd = { x: 0, y: dy > 0 ? 1 : -1 };
        if (!running) { start(); return; }
        if (nd.x === -dir.x && nd.y === -dir.y) return;
        nextDir = nd;
    }, { passive: true });

    return {
        open() {
            reset();
            replayEggDrop(mask);
            showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
                '🐍 彩蛋触发！', '方向键 / WASD 控制，吃掉红点得分', '开始游戏');
        }
    };
})();

/* ============================================================
   彩蛋二：切水果
   触发：搜索框输入 FRUIT 后连按 10 次回车
   ============================================================ */
const FruitGame = (function () {
    const mask = document.getElementById('fruitMask');
    const canvas = document.getElementById('fruitCanvas');
    const scoreEl = document.getElementById('fruitScore');
    const bestEl = document.getElementById('fruitBest');
    const livesEl = document.getElementById('fruitLives');
    const overlayEl = document.getElementById('fruitOverlay');
    const overlayTitleEl = document.getElementById('fruitOverlayTitle');
    const overlaySubEl = document.getElementById('fruitOverlaySub');
    const startBtn = document.getElementById('fruitStartBtn');
    const closeBtn = document.getElementById('fruitClose');

    const FRUITS = [
        { emoji: '🍉', color: '#ff5b6e', scale: 1.12 },
        { emoji: '🍎', color: '#e63946', scale: 1.00 },
        { emoji: '🍊', color: '#ff9f1c', scale: 1.00 },
        { emoji: '🍋', color: '#ffd93d', scale: 0.95 },
        { emoji: '🍇', color: '#9b5de5', scale: 1.02 },
        { emoji: '🍓', color: '#ff477e', scale: 0.92 },
        { emoji: '🥝', color: '#7cb518', scale: 0.95 },
        { emoji: '🍑', color: '#ffb4a2', scale: 1.00 },
        { emoji: '🍍', color: '#ffca3a', scale: 1.10 }
    ];
    const BOMB = { emoji: '💣', color: '#ff6b35', scale: 1.05 };
    const TRAIL_LIFE = 130, MAX_LIVES = 3;

    let W = 480, H = 520;
    let ctx = setupCanvas(canvas, W, H);
    let fruits = [], particles = [], pending = [], trail = [];
    let score = 0, lives = MAX_LIVES;
    let best = parseInt(localStorage.getItem('aries-fruit-best') || '0', 10) || 0;
    let running = false, paused = false, spawnTimer = 0, shake = 0, lastTime = 0, rafId = null;

    bestEl.textContent = String(best);

    function updateHud() {
        scoreEl.textContent = String(score);
        bestEl.textContent = String(best);
        livesEl.textContent = lives > 0 ? '❤'.repeat(lives) : '—';
    }

    function spawnFruit(isBomb) {
        const base = Math.min(W, H) * 0.062;
        const def = isBomb ? BOMB : FRUITS[(Math.random() * FRUITS.length) | 0];
        const r = base * (def.scale || 1);
        const G = H * 0.00085;
        const x = W * (0.14 + Math.random() * 0.72);
        const rise = H * (0.62 + Math.random() * 0.26);
        const vy = -Math.sqrt(2 * G * rise);
        const vx = (W / 2 - x) * 0.006 + (Math.random() - 0.5) * W * 0.0018;

        fruits.push({
            x, y: H + r, vx, vy, r,
            rot: (Math.random() - 0.5) * 0.6,
            rotSpeed: (Math.random() - 0.5) * 0.06,
            emoji: def.emoji, color: def.color, bomb: !!isBomb
        });
    }

    function burst(x, y, count, color) {
        for (let i = 0; i < count; i++) {
            const a = Math.random() * Math.PI * 2;
            const sp = 1.5 + Math.random() * 5;
            particles.push({
                x, y,
                vx: Math.cos(a) * sp,
                vy: Math.sin(a) * sp - 1.4,
                r: 2 + Math.random() * 3.5,
                color, life: 1
            });
        }
    }

    function loseLife() {
        lives -= 1;
        updateHud();
        if (lives <= 0) endGame();
    }

    function segCircle(x1, y1, x2, y2, cx, cy, r) {
        const dx = x2 - x1, dy = y2 - y1;
        const len2 = dx * dx + dy * dy;
        let t = len2 ? ((cx - x1) * dx + (cy - y1) * dy) / len2 : 0;
        t = Math.max(0, Math.min(1, t));
        const px = x1 + t * dx, py = y1 + t * dy;
        return Math.hypot(cx - px, cy - py) <= r;
    }

    function sliceFruit(f) {
        const idx = fruits.indexOf(f);
        if (idx === -1) return;
        fruits.splice(idx, 1);
        if (f.bomb) {
            shake = 22;
            burst(f.x, f.y, 26, '#ff6b35');
            burst(f.x, f.y, 14, '#ffd93d');
            loseLife();
            return;
        }
        score += 10;
        updateHud();
        burst(f.x, f.y, 14, f.color);
    }

    function checkSlice(x1, y1, x2, y2) {
        for (let i = fruits.length - 1; i >= 0; i--) {
            const f = fruits[i];
            if (segCircle(x1, y1, x2, y2, f.x, f.y, f.r * 0.92)) sliceFruit(f);
        }
    }

    function addTrailPoint(x, y) {
        const now = performance.now();
        while (trail.length && now - trail[0].t > TRAIL_LIFE) trail.shift();
        const prev = trail[trail.length - 1];
        trail.push({ x, y, t: now });
        if (trail.length > 24) trail.shift();
        if (prev && running && !paused) {
            const dist = Math.hypot(x - prev.x, y - prev.y);
            if (dist > 3) checkSlice(prev.x, prev.y, x, y);
        }
    }

    function toLocal(e) {
        const rect = canvas.getBoundingClientRect();
        return {
            x: (e.clientX - rect.left) * (W / rect.width),
            y: (e.clientY - rect.top) * (H / rect.height)
        };
    }

    canvas.addEventListener('pointerdown', e => {
        if (!running) return;
        e.preventDefault();
        const p = toLocal(e);
        trail = [{ x: p.x, y: p.y, t: performance.now() }];
    });

    canvas.addEventListener('pointermove', e => {
        if (!running || paused) return;
        const p = toLocal(e);
        addTrailPoint(p.x, p.y);
    });

    function update(dt) {
        const G = H * 0.00085;
        if (shake > 0) shake = Math.max(0, shake - 1.2 * dt);

        for (let i = pending.length - 1; i >= 0; i--) {
            pending[i].delay -= dt;
            if (pending[i].delay <= 0) {
                spawnFruit(pending[i].bomb);
                pending.splice(i, 1);
            }
        }

        spawnTimer -= dt;
        if (spawnTimer <= 0) {
            spawnTimer = Math.max(22, 70 - score * 0.05) + Math.random() * 26;
            const bombChance = Math.min(0.22, 0.09 + score / 2500);
            spawnFruit(Math.random() < bombChance);
            if (Math.random() < 0.28) pending.push({ delay: 8 + Math.random() * 14, bomb: Math.random() < bombChance });
        }

        for (let i = fruits.length - 1; i >= 0; i--) {
            const f = fruits[i];
            f.vy += G * dt;
            f.x += f.vx * dt;
            f.y += f.vy * dt;
            f.rot += f.rotSpeed * dt;
            if (f.y - f.r > H + 30 && f.vy > 0) {
                fruits.splice(i, 1);
                if (!f.bomb) { shake = Math.max(shake, 7); loseLife(); }
                continue;
            }
            if (f.x < -f.r * 5 || f.x > W + f.r * 5) fruits.splice(i, 1);
        }

        for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.vy += 0.34 * dt;
            p.x += p.vx * dt;
            p.y += p.vy * dt;
            p.vx *= Math.pow(0.985, dt);
            p.life -= 0.022 * dt;
            if (p.life <= 0 || p.y > H + 60) particles.splice(i, 1);
        }
    }

    function drawBg() {
        const grad = ctx.createRadialGradient(W * 0.5, H * 0.88, 10, W * 0.5, H * 0.45, H * 0.95);
        grad.addColorStop(0, '#24334d');
        grad.addColorStop(1, '#070b12');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, W, H);

        const glow = ctx.createRadialGradient(W * 0.5, H + 20, 10, W * 0.5, H + 20, W * 0.7);
        glow.addColorStop(0, 'rgba(110, 168, 255, .18)');
        glow.addColorStop(1, 'rgba(110, 168, 255, 0)');
        ctx.fillStyle = glow;
        ctx.fillRect(0, H * 0.6, W, H * 0.4);
    }

    function drawFruit(f) {
        ctx.save();
        ctx.translate(f.x, f.y);
        ctx.rotate(f.rot);
        ctx.font = (f.r * 2) + 'px "Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.shadowColor = f.bomb ? 'rgba(255, 90, 60, .85)' : 'rgba(0, 0, 0, .55)';
        ctx.shadowBlur = f.bomb ? 20 : 10;
        ctx.fillText(f.emoji, 0, 0);
        ctx.restore();
    }

    function drawParticles() {
        for (const p of particles) {
            const a = Math.max(0, p.life);
            ctx.globalAlpha = a;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r * Math.max(0.25, a), 0, Math.PI * 2);
            ctx.fillStyle = p.color;
            ctx.fill();
        }
        ctx.globalAlpha = 1;
    }

    function drawTrail() {
        if (trail.length < 2) return;
        const now = performance.now();
        ctx.save();
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.shadowColor = 'rgba(120, 200, 255, .95)';
        ctx.shadowBlur = 14;
        for (let i = 1; i < trail.length; i++) {
            const a = trail[i - 1], b = trail[i];
            const age = Math.min(1, (now - b.t) / TRAIL_LIFE);
            const alpha = (1 - age) * 0.9;
            if (alpha <= 0.02) continue;
            ctx.globalAlpha = alpha;
            ctx.lineWidth = Math.max(1, 16 * (1 - age));
            ctx.strokeStyle = '#ffffff';
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
        }
        ctx.restore();
        ctx.globalAlpha = 1;
        ctx.shadowBlur = 0;
    }

    function draw() {
        ctx.save();
        if (shake > 0) ctx.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake);
        drawBg();
        for (const f of fruits) drawFruit(f);
        drawParticles();
        drawTrail();
        ctx.restore();
    }

    function loop(time) {
        if (!running) { rafId = null; return; }
        if (!lastTime) lastTime = time;
        let dt = (time - lastTime) / 16.667;
        lastTime = time;
        if (dt > 3) dt = 3;
        if (dt < 0) dt = 0;
        if (!paused) update(dt);
        draw();
        rafId = requestAnimationFrame(loop);
    }

    function reset() {
        fruits = []; particles = []; pending = []; trail = [];
        score = 0; lives = MAX_LIVES; spawnTimer = 26; shake = 0; lastTime = 0;
        running = false; paused = false;
        updateHud();
        draw();
    }

    function start() {
        reset();
        running = true;
        hideEggOverlay(overlayEl);
        if (rafId === null) rafId = requestAnimationFrame(loop);
    }

    function endGame() {
        running = false; paused = false;
        if (score > best) {
            best = score;
            localStorage.setItem('aries-fruit-best', String(best));
        }
        updateHud();
        draw();
        showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
            '游戏结束', '本局得分 ' + score + ' · 最高 ' + best, '再来一局');
    }

    startBtn.addEventListener('click', () => {
        if (running && paused) { paused = false; hideEggOverlay(overlayEl); return; }
        start();
    });

    closeBtn.addEventListener('click', () => {
        running = false; paused = false;
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
        closeEgg(mask);
    });

    mask.addEventListener('click', e => { if (e.target === mask) closeBtn.click(); });

    window.addEventListener('keydown', e => {
        if (!mask.classList.contains('show')) return;
        if (e.key === 'Escape') { e.preventDefault(); closeBtn.click(); return; }
        if (e.key === ' ' || e.key === 'Spacebar' || e.code === 'Space') {
            e.preventDefault();
            if (!running) start();
            else { paused = !paused; if (paused) showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn, '已暂停', '点击按钮继续切水果', '继续游戏'); else hideEggOverlay(overlayEl); }
        }
    });

    return {
        open() {
            reset();
            replayEggDrop(mask);
            showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
                '🍉 彩蛋触发！', '滑动鼠标 / 手指切开水果，别碰炸弹', '开始游戏');
        }
    };
})();

/* ============================================================
   彩蛋三：推箱子
   触发：搜索框输入 BOX 后连按 10 次回车
   ============================================================ */
const SokoGame = (function () {
    const mask = document.getElementById('sokoMask');
    const canvas = document.getElementById('sokoCanvas');
    const stepsEl = document.getElementById('sokoSteps');
    const levelEl = document.getElementById('sokoLevel');
    const totalEl = document.getElementById('sokoTotal');
    const overlayEl = document.getElementById('sokoOverlay');
    const overlayTitleEl = document.getElementById('sokoOverlayTitle');
    const overlaySubEl = document.getElementById('sokoOverlaySub');
    const startBtn = document.getElementById('sokoStartBtn');
    const closeBtn = document.getElementById('sokoClose');

    const LEVELS = [
        [
            '#########',
            '#       #',
            '#  .    #',
            '#       #',
            '#  $    #',
            '#       #',
            '#  @    #',
            '#       #',
            '#########'
        ],
        [
            '#########',
            '#       #',
            '# .   . #',
            '#       #',
            '# $   $ #',
            '#       #',
            '#   @   #',
            '#       #',
            '#########'
        ],
        [
            '#########',
            '#   .   #',
            '#       #',
            '#  $ $  #',
            '#   @   #',
            '#   .   #',
            '#       #',
            '#########'
        ]
    ];

    let ctx = null;
    let levelIdx = 0, map = [], boxes = [], player = { x: 1, y: 1 };
    let rows = 0, cols = 0, cell = 44, steps = 0;
    let running = false, won = false;

    totalEl.textContent = String(LEVELS.length);

    function parse(level) {
        const m = [], bs = [];
        let p = { x: 1, y: 1 };
        for (let y = 0; y < level.length; y++) {
            const row = [];
            for (let x = 0; x < level[y].length; x++) {
                const c = level[y][x];
                if (c === '#') row.push(1);
                else if (c === '.') row.push(2);
                else if (c === '$') { row.push(0); bs.push({ x, y }); }
                else if (c === '*') { row.push(2); bs.push({ x, y }); }
                else if (c === '@') { row.push(0); p = { x, y }; }
                else if (c === '+') { row.push(2); p = { x, y }; }
                else row.push(0);
            }
            m.push(row);
        }
        return { m, bs, p };
    }

    function load(idx) {
        const parsed = parse(LEVELS[idx]);
        map = parsed.m;
        boxes = parsed.bs;
        player = parsed.p;
        rows = map.length;
        cols = map[0].length;
        steps = 0;
        won = false;
        stepsEl.textContent = '0';
        levelEl.textContent = String(idx + 1);

        cell = Math.floor(Math.min(440 / cols, 440 / rows));
        if (cell < 20) cell = 20;
        if (cell > 56) cell = 56;

        ctx = setupCanvas(canvas, cols * cell, rows * cell);
        draw();
    }

    function draw() {
        const isDark = document.body.dataset.theme === 'dark';
        ctx.fillStyle = isDark ? '#0e131b' : '#f4efe2';
        ctx.fillRect(0, 0, cols * cell, rows * cell);

        for (let y = 0; y < rows; y++) {
            for (let x = 0; x < cols; x++) {
                const t = map[y][x];
                const px = x * cell, py = y * cell;
                if (t === 1) {
                    ctx.fillStyle = isDark ? '#2b3646' : '#8b6b3e';
                    ctx.fillRect(px, py, cell, cell);
                    ctx.strokeStyle = isDark ? 'rgba(255,255,255,.05)' : 'rgba(0,0,0,.08)';
                    ctx.lineWidth = 1;
                    ctx.strokeRect(px + .5, py + .5, cell - 1, cell - 1);
                } else {
                    ctx.fillStyle = isDark ? '#141a24' : '#f9f4e8';
                    ctx.fillRect(px, py, cell, cell);
                    if (t === 2) {
                        const cx = px + cell / 2, cy = py + cell / 2;
                        ctx.beginPath();
                        ctx.arc(cx, cy, cell * 0.18, 0, Math.PI * 2);
                        ctx.fillStyle = '#f0b429';
                        ctx.fill();
                        ctx.strokeStyle = 'rgba(240, 180, 41, .5)';
                        ctx.lineWidth = 2;
                        ctx.stroke();
                    }
                }
            }
        }

        for (const b of boxes) {
            const px = b.x * cell, py = b.y * cell;
            const pad = cell * 0.08;
            const onTarget = map[b.y][b.x] === 2;
            ctx.fillStyle = onTarget ? '#4caf50' : (isDark ? '#b88945' : '#c98a3a');
            ctx.fillRect(px + pad, py + pad, cell - pad * 2, cell - pad * 2);
            ctx.strokeStyle = onTarget ? '#2e7d32' : '#7a4f1a';
            ctx.lineWidth = 2;
            ctx.strokeRect(px + pad, py + pad, cell - pad * 2, cell - pad * 2);
            ctx.beginPath();
            ctx.moveTo(px + pad, py + pad);
            ctx.lineTo(px + cell - pad, py + cell - pad);
            ctx.moveTo(px + cell - pad, py + pad);
            ctx.lineTo(px + pad, py + cell - pad);
            ctx.strokeStyle = onTarget ? 'rgba(255,255,255,.5)' : 'rgba(255,255,255,.3)';
            ctx.lineWidth = 1.5;
            ctx.stroke();
        }

        const ppx = player.x * cell, ppy = player.y * cell;
        const cx = ppx + cell / 2, cy = ppy + cell / 2;
        ctx.beginPath();
        ctx.arc(cx, cy, cell * 0.32, 0, Math.PI * 2);
        ctx.fillStyle = '#2f6bff';
        ctx.shadowColor = 'rgba(47, 107, 255, .6)';
        ctx.shadowBlur = 10;
        ctx.fill();
        ctx.shadowBlur = 0;

        ctx.fillStyle = '#ffffff';
        ctx.beginPath(); ctx.arc(cx - cell * 0.11, cy - cell * 0.06, cell * 0.07, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(cx + cell * 0.11, cy - cell * 0.06, cell * 0.07, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#0b1220';
        ctx.beginPath(); ctx.arc(cx - cell * 0.11, cy - cell * 0.06, cell * 0.032, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(cx + cell * 0.11, cy - cell * 0.06, cell * 0.032, 0, Math.PI * 2); ctx.fill();
    }

    function checkWin() {
        return boxes.every(b => map[b.y][b.x] === 2);
    }

    function move(dx, dy) {
        if (!running || won) return;
        const nx = player.x + dx, ny = player.y + dy;
        if (nx < 0 || nx >= cols || ny < 0 || ny >= rows) return;
        if (map[ny][nx] === 1) return;

        const box = boxes.find(b => b.x === nx && b.y === ny);
        if (box) {
            const bx = nx + dx, by = ny + dy;
            if (bx < 0 || bx >= cols || by < 0 || by >= rows) return;
            if (map[by][bx] === 1) return;
            if (boxes.find(b => b.x === bx && b.y === by)) return;
            box.x = bx;
            box.y = by;
        }

        player.x = nx;
        player.y = ny;
        steps++;
        stepsEl.textContent = String(steps);
        draw();

        if (checkWin()) {
            won = true;
            running = false;
            setTimeout(() => {
                if (levelIdx < LEVELS.length - 1) {
                    levelIdx++;
                    load(levelIdx);
                    showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
                        '本关通过！', '准备进入第 ' + (levelIdx + 1) + ' 关', '继续');
                } else {
                    showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
                        '🎉 恭喜通关！', '全部 ' + LEVELS.length + ' 关已完成', '重新开始');
                    levelIdx = 0;
                }
            }, 240);
        }
    }

    function start() {
        hideEggOverlay(overlayEl);
        running = true;
        won = false;
    }

    startBtn.addEventListener('click', () => {
        if (won) {
            levelIdx = 0;
            load(levelIdx);
            start();
            return;
        }
        start();
    });

    closeBtn.addEventListener('click', () => {
        running = false;
        won = false;
        closeEgg(mask);
    });

    mask.addEventListener('click', e => { if (e.target === mask) closeBtn.click(); });

    window.addEventListener('keydown', e => {
        if (!mask.classList.contains('show')) return;
        if (e.key === 'Escape') { e.preventDefault(); closeBtn.click(); return; }
        if (e.key === 'r' || e.key === 'R') {
            e.preventDefault();
            load(levelIdx);
            start();
            return;
        }
        let dx = 0, dy = 0;
        const k = (e.key || '').toLowerCase();
        if (e.key === 'ArrowUp' || k === 'w') dy = -1;
        else if (e.key === 'ArrowDown' || k === 's') dy = 1;
        else if (e.key === 'ArrowLeft' || k === 'a') dx = -1;
        else if (e.key === 'ArrowRight' || k === 'd') dx = 1;
        if (!dx && !dy) return;
        e.preventDefault();
        if (!running && !won) start();
        move(dx, dy);
    });

    return {
        open() {
            levelIdx = 0;
            load(levelIdx);
            replayEggDrop(mask);
            showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
                '📦 彩蛋触发！', '把所有箱子推到金色目标点上', '开始游戏');
        }
    };
})();

/* ============================================================
   彩蛋四：迷宫
   触发：搜索框输入 HUOSE / HOUSE 后连按 10 次回车
   四种模式：无尽 / 计时赛 / 奖励赛 / 作弊赛
   ============================================================ */
const MazeGame = (function () {
    const mask = document.getElementById('mazeMask');
    const canvas = document.getElementById('mazeCanvas');
    const stepsEl = document.getElementById('mazeSteps');
    const timeEl = document.getElementById('mazeTime');
    const heartsWrap = document.getElementById('mazeHeartsWrap');
    const heartsEl = document.getElementById('mazeHearts');
    const countdownWrap = document.getElementById('mazeCountdownWrap');
    const countdownEl = document.getElementById('mazeCountdown');
    const overlayEl = document.getElementById('mazeOverlay');
    const overlayTitleEl = document.getElementById('mazeOverlayTitle');
    const overlaySubEl = document.getElementById('mazeOverlaySub');
    const startBtn = document.getElementById('mazeStartBtn');
    const closeBtn = document.getElementById('mazeClose');
    const timerRow = document.getElementById('mazeTimerRow');
    const minutesInput = document.getElementById('mazeMinutes');
    const timerApply = document.getElementById('mazeTimerApply');
    const modeButtons = document.querySelectorAll('.maze-mode');

    const CELLS = 9;                   // 9x9 单元格
    const COLS = CELLS * 2 + 1;        // 19
    const ROWS = CELLS * 2 + 1;        // 19
    const CELL = 24;

    let ctx = setupCanvas(canvas, COLS * CELL, ROWS * CELL);

    let grid = [];
    let player = { x: 1, y: 1 };
    let goal = { x: COLS - 2, y: ROWS - 2 };
    let apples = [], spikes = [], solution = [];
    let steps = 0, hearts = 3;
    let mode = 'endless';
    let running = false, paused = false;
    let elapsed = 0, timeLimit = 0, clearedCount = 0;
    let rafId = null, lastFrame = 0;

    function shuffle(a) {
        for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
    }

    /* 递归回溯，保证迷宫有解（完美迷宫） */
    function generateMaze() {
        const g = [];
        for (let y = 0; y < ROWS; y++) g.push(new Array(COLS).fill(1));

        const stack = [[1, 1]];
        g[1][1] = 0;

        while (stack.length) {
            const [cx, cy] = stack[stack.length - 1];
            const dirs = shuffle([[0, -2], [0, 2], [-2, 0], [2, 0]]);
            let moved = false;
            for (const [dx, dy] of dirs) {
                const nx = cx + dx, ny = cy + dy;
                if (nx > 0 && nx < COLS - 1 && ny > 0 && ny < ROWS - 1 && g[ny][nx] === 1) {
                    g[ny][nx] = 0;
                    g[cy + dy / 2][cx + dx / 2] = 0;
                    stack.push([nx, ny]);
                    moved = true;
                    break;
                }
            }
            if (!moved) stack.pop();
        }
        return g;
    }

    /* BFS 求最短路径（作弊赛用） */
    function solveBFS(g, start, end) {
        const key = (x, y) => x + ',' + y;
        const prev = new Map();
        const queue = [start];
        prev.set(key(start.x, start.y), null);

        while (queue.length) {
            const cur = queue.shift();
            if (cur.x === end.x && cur.y === end.y) break;
            for (const [dx, dy] of [[0, -1], [0, 1], [-1, 0], [1, 0]]) {
                const nx = cur.x + dx, ny = cur.y + dy;
                if (nx < 0 || nx >= COLS || ny < 0 || ny >= ROWS) continue;
                if (g[ny][nx] !== 0) continue;
                if (prev.has(key(nx, ny))) continue;
                prev.set(key(nx, ny), cur);
                queue.push({ x: nx, y: ny });
            }
        }

        const path = [];
        let cur = end;
        while (cur) {
            path.push(cur);
            const p = prev.get(key(cur.x, cur.y));
            if (!p) break;
            cur = p;
        }
        return path.reverse();
    }

    /* 苹果与刺：只生成在可通行的路上，且避开玩家和门 */
    function spawnRewards() {
        apples = [];
        spikes = [];
        if (mode !== 'reward') return;

        const candidates = [];
        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                if (grid[y][x] !== 0) continue;
                if (x === player.x && y === player.y) continue;
                if (x === goal.x && y === goal.y) continue;
                candidates.push({ x, y });
            }
        }
        shuffle(candidates);

        const appleCount = Math.min(3, candidates.length);
        for (let i = 0; i < appleCount; i++) apples.push(candidates.pop());

        const spikeCount = Math.min(5, candidates.length);
        for (let i = 0; i < spikeCount; i++) spikes.push(candidates.pop());
    }

    function reset(keepStats) {
        grid = generateMaze();
        player = { x: 1, y: 1 };
        goal = { x: COLS - 2, y: ROWS - 2 };
        grid[goal.y][goal.x] = 0;

        spawnRewards();

        if (!keepStats) {
            steps = 0;
            hearts = 3;
            elapsed = 0;
        }
        stepsEl.textContent = String(steps);
        heartsEl.textContent = hearts > 0 ? '❤'.repeat(hearts) : '—';
        timeEl.textContent = '0.0s';

        solution = (mode === 'cheat') ? solveBFS(grid, player, goal) : [];
        draw();
    }

    function draw() {
        const isDark = document.body.dataset.theme === 'dark';
        const W = COLS * CELL, H = ROWS * CELL;

        ctx.fillStyle = isDark ? '#0a0f18' : '#f7f1e3';
        ctx.fillRect(0, 0, W, H);

        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                const px = x * CELL, py = y * CELL;
                if (grid[y][x] === 1) {
                    ctx.fillStyle = isDark ? '#2b3646' : '#8b6b3e';
                    ctx.fillRect(px, py, CELL, CELL);
                    ctx.strokeStyle = isDark ? 'rgba(255,255,255,.05)' : 'rgba(0,0,0,.06)';
                    ctx.lineWidth = 1;
                    ctx.strokeRect(px + .5, py + .5, CELL - 1, CELL - 1);
                } else {
                    ctx.fillStyle = isDark ? '#141a24' : '#fdf8ec';
                    ctx.fillRect(px, py, CELL, CELL);
                }
            }
        }

        /* 作弊路线 */
        if (mode === 'cheat' && solution.length > 1) {
            const pulse = 0.6 + 0.4 * Math.sin(performance.now() / 260);
            for (let i = 1; i < solution.length - 1; i++) {
                const p = solution[i];
                const cx = p.x * CELL + CELL / 2;
                const cy = p.y * CELL + CELL / 2;
                ctx.beginPath();
                ctx.arc(cx, cy, CELL * 0.15 * pulse + CELL * 0.05, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(255, 200, 60, .9)';
                ctx.fill();
            }
        }

        /* 出口门 */
        const gx = goal.x * CELL, gy = goal.y * CELL;
        ctx.fillStyle = '#4caf50';
        ctx.fillRect(gx + 2, gy + 2, CELL - 4, CELL - 4);
        ctx.strokeStyle = 'rgba(255,255,255,.6)';
        ctx.lineWidth = 1.5;
        ctx.strokeRect(gx + 2.5, gy + 2.5, CELL - 5, CELL - 5);
        ctx.font = (CELL * 0.68) + 'px "Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('🚪', gx + CELL / 2, gy + CELL / 2 + 1);

        /* 苹果 */
        for (const a of apples) {
            const cx = a.x * CELL + CELL / 2;
            const cy = a.y * CELL + CELL / 2;
            ctx.beginPath();
            ctx.arc(cx, cy, CELL * 0.34, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(230, 57, 70, .22)';
            ctx.fill();
            ctx.font = (CELL * 0.72) + 'px "Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif';
            ctx.fillText('🍎', cx, cy + 1);
        }

        /* 刺 */
        for (const s of spikes) {
            const cx = s.x * CELL + CELL / 2;
            const cy = s.y * CELL + CELL / 2;
            ctx.beginPath();
            ctx.arc(cx, cy, CELL * 0.34, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255, 107, 53, .22)';
            ctx.fill();
            ctx.font = (CELL * 0.72) + 'px "Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif';
            ctx.fillText('🌵', cx, cy + 1);
        }

        /* 玩家 */
        const px = player.x * CELL + CELL / 2;
        const py = player.y * CELL + CELL / 2;
        ctx.beginPath();
        ctx.arc(px, py, CELL * 0.32, 0, Math.PI * 2);
        ctx.fillStyle = '#2f6bff';
        ctx.shadowColor = 'rgba(47, 107, 255, .65)';
        ctx.shadowBlur = 10;
        ctx.fill();
        ctx.shadowBlur = 0;

        ctx.fillStyle = '#ffffff';
        ctx.beginPath(); ctx.arc(px - CELL * 0.1, py - CELL * 0.05, CELL * 0.065, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(px + CELL * 0.1, py - CELL * 0.05, CELL * 0.065, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#0b1220';
        ctx.beginPath(); ctx.arc(px - CELL * 0.1, py - CELL * 0.05, CELL * 0.03, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(px + CELL * 0.1, py - CELL * 0.05, CELL * 0.03, 0, Math.PI * 2); ctx.fill();
    }

    function updateHud() {
        stepsEl.textContent = String(steps);
        heartsEl.textContent = hearts > 0 ? '❤'.repeat(hearts) : '—';
    }

    function endGame(reason) {
        running = false;
        paused = false;
        let sub = reason || '';
        if (mode === 'timed') sub = '用时 ' + elapsed.toFixed(1) + ' 秒';
        else if (mode === 'reward') sub = '步数 ' + steps + ' · 剩余心 ' + Math.max(0, hearts);
        else sub = '步数 ' + steps + ' · 用时 ' + elapsed.toFixed(1) + ' 秒';
        showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn, '游戏结束', sub, '再来一局');
    }

    function reachGoal() {
        running = false;
        if (mode === 'endless') {
            clearedCount++;
            showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
                '🎉 通关！', '已通过 ' + clearedCount + ' 个迷宫，准备进入下一个', '继续');
        } else if (mode === 'timed') {
            showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
                '🎉 通关！', '用时 ' + elapsed.toFixed(1) + ' 秒 · 剩余 ' + Math.max(0, timeLimit - elapsed).toFixed(1) + ' 秒', '再来一局');
        } else if (mode === 'reward') {
            showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
                '🎉 通关！', '步数 ' + steps + ' · 剩余 ' + hearts + ' 颗心', '再来一局');
        } else {
            showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
                '🎉 通关！', '作弊路线走完啦，换个模式试试吧', '再来一局');
        }
    }

    function move(dx, dy) {
        if (!running || paused) return;

        const nx = player.x + dx, ny = player.y + dy;
        if (nx < 0 || nx >= COLS || ny < 0 || ny >= ROWS) return;
        if (grid[ny][nx] === 1) return;

        player.x = nx;
        player.y = ny;
        steps++;
        stepsEl.textContent = String(steps);

        if (mode === 'reward') {
            const ai = apples.findIndex(a => a.x === nx && a.y === ny);
            if (ai !== -1) {
                apples.splice(ai, 1);
                hearts++;
                updateHud();
            }
            const si = spikes.findIndex(s => s.x === nx && s.y === ny);
            if (si !== -1) {
                spikes.splice(si, 1);
                hearts--;
                updateHud();
                if (hearts <= 0) { draw(); endGame('心用完了'); return; }
            }
        }

        draw();

        if (nx === goal.x && ny === goal.y) reachGoal();
    }

    function loop(time) {
        if (!running) { rafId = null; return; }
        if (!lastFrame) lastFrame = time;
        const dt = (time - lastFrame) / 1000;
        lastFrame = time;

        if (!paused) {
            elapsed += dt;
            timeEl.textContent = elapsed.toFixed(1) + 's';
            if (mode === 'timed') {
                const remain = Math.max(0, timeLimit - elapsed);
                countdownEl.textContent = remain.toFixed(1) + 's';
                if (remain <= 0) { draw(); endGame('时间到'); return; }
            }
            if (mode === 'cheat') draw();  // 让金色路线有呼吸感
        }
        rafId = requestAnimationFrame(loop);
    }

    function start() {
        hideEggOverlay(overlayEl);
        running = true;
        paused = false;
        elapsed = 0;
        lastFrame = 0;
        timeEl.textContent = '0.0s';
        if (mode === 'timed') countdownEl.textContent = timeLimit.toFixed(1) + 's';
        if (rafId === null) rafId = requestAnimationFrame(loop);
    }

    function applyModeUI() {
        modeButtons.forEach(b => b.classList.toggle('active', b.dataset.mode === mode));
        timerRow.classList.toggle('show', mode === 'timed');
        countdownWrap.style.display = mode === 'timed' ? 'inline' : 'none';
        heartsWrap.style.display = mode === 'reward' ? 'inline' : 'none';
    }

    function readMinutes() {
        const v = parseFloat(minutesInput.value);
        if (!isFinite(v) || v <= 0) return 60;
        return Math.max(1, Math.round(v * 60));
    }

    modeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            if (running) return;
            mode = btn.dataset.mode;
            applyModeUI();
            reset(false);
            let sub = '走到右下角的门通关';
            if (mode === 'timed') {
                timeLimit = readMinutes();
                sub = '限时 ' + timeLimit + ' 秒，速通迷宫';
            } else if (mode === 'reward') {
                sub = '3 颗心，吃苹果加心，踩刺扣心';
            } else if (mode === 'cheat') {
                sub = '金色圆点即为正确路线';
            } else if (mode === 'endless') {
                sub = '通关后自动进入下一个迷宫';
            }
            showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
                '🌀 ' + btn.textContent, sub, '开始游戏');
        });
    });

    timerApply.addEventListener('click', () => {
        timeLimit = readMinutes();
        countdownEl.textContent = timeLimit.toFixed(1) + 's';
    });

    startBtn.addEventListener('click', () => {
        if (mode === 'endless' && clearedCount > 0 && !running) reset(true);
        else reset(false);
        if (mode === 'timed') timeLimit = readMinutes();
        start();
    });

    closeBtn.addEventListener('click', () => {
        running = false;
        paused = false;
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
        closeEgg(mask);
    });

    mask.addEventListener('click', e => { if (e.target === mask) closeBtn.click(); });

    window.addEventListener('keydown', e => {
        if (!mask.classList.contains('show')) return;
        if (e.key === 'Escape') { e.preventDefault(); closeBtn.click(); return; }
        if (e.key === 'r' || e.key === 'R') {
            e.preventDefault();
            if (running) { reset(false); start(); }
            return;
        }
        let dx = 0, dy = 0;
        const k = (e.key || '').toLowerCase();
        if (e.key === 'ArrowUp' || k === 'w') dy = -1;
        else if (e.key === 'ArrowDown' || k === 's') dy = 1;
        else if (e.key === 'ArrowLeft' || k === 'a') dx = -1;
        else if (e.key === 'ArrowRight' || k === 'd') dx = 1;
        if (!dx && !dy) return;
        e.preventDefault();

        if (!running) {
            if (mode === 'endless' && clearedCount > 0) reset(true);
            else reset(false);
            if (mode === 'timed') timeLimit = readMinutes();
            start();
        }
        move(dx, dy);
    });

    return {
        open() {
            mode = 'endless';
            clearedCount = 0;
            timeLimit = 0;
            applyModeUI();
            reset(false);
            replayEggDrop(mask);
            showEggOverlay(overlayEl, overlayTitleEl, overlaySubEl, startBtn,
                '🌀 彩蛋触发！', '走到右下角的门即可通关', '开始游戏');
        }
    };
})();

const SlidingPuzzleGame = (function () {
    const mask = document.getElementById('puzzleMask');
    const board = document.getElementById('puzzleBoard');
    const movesEl = document.getElementById('puzzleMoves');
    const timeEl = document.getElementById('puzzleTime');
    const overlay = document.getElementById('puzzleOverlay');
    const overlaySub = document.getElementById('puzzleOverlaySub');
    const playAgainButton = document.getElementById('puzzlePlayAgain');
    const restartButton = document.getElementById('puzzleRestart');
    const closeButton = document.getElementById('puzzleClose');
    const tilesByValue = new Map();
    const emptyCell = document.createElement('div');
    emptyCell.className = 'puzzle-empty';
    emptyCell.setAttribute('aria-hidden', 'true');

    for (let value = 1; value <= 15; value++) {
        const tile = document.createElement('button');
        tile.type = 'button';
        tile.className = 'puzzle-tile';
        tile.textContent = String(value);
        tile.setAttribute('aria-label', '移动数字 ' + value);
        tilesByValue.set(value, tile);
    }

    let tiles = [];
    let moveCount = 0;
    let startedAt = 0;
    let timerId = 0;
    let active = false;

    function render() {
        board.replaceChildren(...tiles.map((value, tileIndex) => {
            if (value === 0) return emptyCell;
            const tile = tilesByValue.get(value);
            tile.dataset.index = String(tileIndex);
            return tile;
        }));
    }

    function updateStats() {
        movesEl.textContent = String(moveCount);
        const elapsedSeconds = startedAt ? Math.floor((Date.now() - startedAt) / 1000) : 0;
        const minutes = Math.floor(elapsedSeconds / 60);
        const seconds = String(elapsedSeconds % 60).padStart(2, '0');
        timeEl.textContent = minutes + ':' + seconds;
    }

    function isSolved() {
        return tiles.every((value, tileIndex) => value === (tileIndex === 15 ? 0 : tileIndex + 1));
    }

    function startNewGame() {
        window.clearInterval(timerId);
        tiles = Array.from({ length: 15 }, (_, index) => index + 1).concat(0);
        let emptyIndex = 15;
        let previousEmptyIndex = -1;

        for (let step = 0; step < 160; step++) {
            const neighbors = [];
            if (emptyIndex % 4 > 0) neighbors.push(emptyIndex - 1);
            if (emptyIndex % 4 < 3) neighbors.push(emptyIndex + 1);
            if (emptyIndex >= 4) neighbors.push(emptyIndex - 4);
            if (emptyIndex < 12) neighbors.push(emptyIndex + 4);
            const options = neighbors.filter(index => index !== previousEmptyIndex);
            const nextIndex = options[Math.floor(Math.random() * options.length)];
            [tiles[emptyIndex], tiles[nextIndex]] = [tiles[nextIndex], tiles[emptyIndex]];
            previousEmptyIndex = emptyIndex;
            emptyIndex = nextIndex;
        }

        if (isSolved()) [tiles[14], tiles[15]] = [tiles[15], tiles[14]];
        moveCount = 0;
        startedAt = Date.now();
        active = true;
        overlay.classList.remove('show');
        render();
        updateStats();
        timerId = window.setInterval(updateStats, 250);
    }

    function moveTile(tileIndex) {
        if (!active) return;
        const emptyIndex = tiles.indexOf(0);
        const distance = Math.abs(Math.floor(tileIndex / 4) - Math.floor(emptyIndex / 4))
            + Math.abs(tileIndex % 4 - emptyIndex % 4);
        if (distance !== 1) return;

        [tiles[emptyIndex], tiles[tileIndex]] = [tiles[tileIndex], tiles[emptyIndex]];
        moveCount++;
        render();
        updateStats();

        if (isSolved()) {
            active = false;
            window.clearInterval(timerId);
            overlaySub.textContent = '用时 ' + timeEl.textContent + '，共移动 ' + moveCount + ' 步。';
            overlay.classList.add('show');
        }
    }

    function close() {
        active = false;
        window.clearInterval(timerId);
        mask.classList.remove('show');
        document.body.classList.remove('egg-locked');
    }

    board.addEventListener('click', event => {
        const tile = event.target.closest('.puzzle-tile');
        if (tile) moveTile(Number(tile.dataset.index));
    });
    restartButton.addEventListener('click', startNewGame);
    playAgainButton.addEventListener('click', startNewGame);
    closeButton.addEventListener('click', close);
    mask.addEventListener('click', event => { if (event.target === mask) close(); });

    document.addEventListener('keydown', event => {
        if (!mask.classList.contains('show')) return;
        if (event.key === 'Escape') {
            close();
            return;
        }
        if (event.key.toLowerCase() === 'r') {
            event.preventDefault();
            startNewGame();
            return;
        }

        const directions = {
            ArrowLeft: [0, -1],
            ArrowRight: [0, 1],
            ArrowUp: [-1, 0],
            ArrowDown: [1, 0]
        };
        const direction = directions[event.key];
        if (!direction || !active) return;
        const emptyIndex = tiles.indexOf(0);
        const row = Math.floor(emptyIndex / 4) + direction[0];
        const column = emptyIndex % 4 + direction[1];
        if (row < 0 || row > 3 || column < 0 || column > 3) return;
        event.preventDefault();
        moveTile(row * 4 + column);
    });

    return {
        open() {
            document.getElementById('searchInput').blur();
            startNewGame();
            replayEggDrop(mask);
        }
    };
})();

/* ============================================================
   彩蛋触发器：一个统一的监听
   暗号 → 连按 10 次回车
   ============================================================ */
(function initEggTrigger() {
    const EGG_PRESSES = 10;
    const EGG_MAP = {
        'aries.zxcvbnm': 'snake',
        'move': 'sliding-puzzle',
        'fruit': 'fruit',
        'box': 'soko',
        'huose': 'maze',
        'house': 'maze',
        'iso': 'iso',
        'chess': 'board-games',
        'between': 'go',
        'mod': 'xiangqi-puzzle',
        '井字棋': 'ttt',
        'tic-tac-toe': 'ttt',
        'tictactoe': 'ttt',
        '五子棋': 'gomoku'
    };

    let pressCount = 0;
    let currentEgg = null;
    let audioContext = null;

    function playPressSound(count) {
        const AudioContextType = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextType) return;
        try {
            if (!audioContext) audioContext = new AudioContextType();
            if (audioContext.state === 'suspended') audioContext.resume();
            const now = audioContext.currentTime;
            const oscillator = audioContext.createOscillator();
            const volume = audioContext.createGain();
            oscillator.type = 'sine';
            oscillator.frequency.setValueAtTime(420 + count * 32, now);
            volume.gain.setValueAtTime(0.0001, now);
            volume.gain.exponentialRampToValueAtTime(0.045, now + 0.012);
            volume.gain.exponentialRampToValueAtTime(0.0001, now + 0.11);
            oscillator.connect(volume);
            volume.connect(audioContext.destination);
            oscillator.start(now);
            oscillator.stop(now + 0.12);
        } catch (error) {
            audioContext = null;
        }
    }

    function flashSearchInput() {
        searchInput.classList.remove('egg-flash');
        void searchInput.offsetWidth;
        searchInput.classList.add('egg-flash');
    }

    searchInput.addEventListener('input', () => {
        pressCount = 0;
        currentEgg = null;
    });

    searchInput.addEventListener('keydown', e => {
        if (e.key !== 'Enter') return;

        const v = searchInput.value.trim().toLowerCase();
        const egg = EGG_MAP[v];

        if (!egg) {
            pressCount = 0;
            currentEgg = null;
            return;
        }

        e.preventDefault();

        if (currentEgg !== egg) {
            currentEgg = egg;
            pressCount = 0;
        }
        pressCount++;
        playPressSound(pressCount);
        flashSearchInput();

        if (pressCount >= EGG_PRESSES) {
            pressCount = 0;
            currentEgg = null;
            triggerEgg(egg);
        }
    });

    function triggerEgg(egg) {
        switch (egg) {
            case 'snake': SnakeGame.open(); break;
            case 'sliding-puzzle': SlidingPuzzleGame.open(); break;
            case 'fruit': FruitGame.open(); break;
            case 'soko': SokoGame.open(); break;
            case 'maze': MazeGame.open(); break;
            case 'board-games': BoardGames.open('chess'); break;
            case 'go': BoardGames.open('go'); break;
            case 'xiangqi-puzzle': XiangqiPuzzle.open(); break;
            case 'ttt': BoardGames.open('ttt'); break;
            case 'gomoku': BoardGames.open('gomoku'); break;
            case 'iso':
                searchInput.blur();
                window.open('https://next.itellyou.cn', '_blank', 'noopener');
                break;
        }
    }
})();

const BoardGames = (function () {
