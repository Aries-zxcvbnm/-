function sortSoftware(items) {
    if (sortMode === 'default') return items;
    const sorted = [...items];
    if (sortMode === 'name') {
        sorted.sort((a, b) => a.name.localeCompare(b.name, 'zh-CN', { numeric: true, sensitivity: 'base' }));
        return sorted;
    }
    const metric = sortMode === 'rating' ? 'rating' : 'heat';
    sorted.sort((a, b) => {
        const left = Number.parseFloat(a[metric]) || 0;
        const right = Number.parseFloat(b[metric]) || 0;
        return right - left || a.name.localeCompare(b.name, 'zh-CN', { numeric: true, sensitivity: 'base' });
    });
    return sorted;
}

