function makeModalParticleTargets(modalElement, item) {
    const modalRect = modalElement.getBoundingClientRect();
    const maskCanvas = document.createElement('canvas');
    maskCanvas.width = Math.max(1, Math.ceil(modalRect.width));
    maskCanvas.height = Math.max(1, Math.ceil(modalRect.height));
    const maskContext = maskCanvas.getContext('2d', { willReadFrequently: true });
    const position = element => {
        const rect = element.getBoundingClientRect();
        return { x: rect.left - modalRect.left, y: rect.top - modalRect.top, width: rect.width, height: rect.height };
    };
    const drawText = (element, text, align) => {
        if (!element || !text) return;
        const rect = position(element);
        const style = getComputedStyle(element);
        maskContext.font = style.font;
        maskContext.textAlign = align || 'left';
        maskContext.textBaseline = 'middle';
        maskContext.fillStyle = '#fff';
        const x = align === 'center' ? rect.x + rect.width / 2 : rect.x + 3;
        maskContext.fillText(text, x, rect.y + rect.height / 2, Math.max(1, rect.width - 6));
    };

    maskContext.strokeStyle = '#fff';
    maskContext.lineWidth = 1.5;
    maskContext.strokeRect(2, 2, maskCanvas.width - 4, maskCanvas.height - 4);
    maskContext.strokeRect(6, 6, maskCanvas.width - 12, maskCanvas.height - 12);
    drawText(modalTitle, item.name, 'center');
    drawText(modalElement.querySelector('.sub'), '请选择下载方式', 'center');

    const infoRect = position(modalElement.querySelector('.software-info'));
    maskContext.strokeRect(infoRect.x, infoRect.y, infoRect.width, infoRect.height);
    for (const cell of modalElement.querySelectorAll('.software-info > div')) {
        const rect = position(cell);
        drawText(cell, cell.textContent, 'left');
        if (rect.x > infoRect.x + infoRect.width / 2) {
            maskContext.beginPath();
            maskContext.moveTo(rect.x - 4, infoRect.y);
            maskContext.lineTo(rect.x - 4, infoRect.y + infoRect.height);
            maskContext.stroke();
        }
    }
    maskContext.beginPath();
    maskContext.moveTo(infoRect.x, infoRect.y + infoRect.height / 2);
    maskContext.lineTo(infoRect.x + infoRect.width, infoRect.y + infoRect.height / 2);
    maskContext.stroke();

    const intro = modalElement.querySelector('.software-intro');
    const introRect = position(intro);
    const introStyle = getComputedStyle(intro);
    maskContext.font = introStyle.font;
    maskContext.textAlign = 'left';
    maskContext.textBaseline = 'top';
    maskContext.fillStyle = '#fff';
    let line = '';
    let lineY = introRect.y + 3;
    for (const character of intro.textContent) {
        const nextLine = line + character;
        if (maskContext.measureText(nextLine).width > introRect.width - 6 && line) {
            maskContext.fillText(line, introRect.x + 3, lineY);
            line = character;
            lineY += 17;
        } else {
            line = nextLine;
        }
    }
    if (line) maskContext.fillText(line, introRect.x + 3, lineY);

    for (const button of modalElement.querySelectorAll('.btn')) {
        const rect = position(button);
        maskContext.strokeRect(rect.x, rect.y, rect.width, rect.height);
        if (button.classList.contains('primary')) {
            maskContext.fillStyle = 'rgba(255,255,255,.22)';
            maskContext.fillRect(rect.x + 2, rect.y + 2, rect.width - 4, rect.height - 4);
        }
        drawText(button, button.textContent, 'center');
    }

    const pixels = maskContext.getImageData(0, 0, maskCanvas.width, maskCanvas.height).data;
    const targets = [];
    for (let y = 1; y < maskCanvas.height; y += 2) {
        for (let x = 1; x < maskCanvas.width; x += 2) {
            if (pixels[(y * maskCanvas.width + x) * 4 + 3] > 28) targets.push({ x: modalRect.left + x, y: modalRect.top + y });
        }
    }
    return targets;
}

function resetModalParticles() {
    if (modalParticleFrame) cancelAnimationFrame(modalParticleFrame);
    clearTimeout(modalParticleRevealTimer);
    clearTimeout(modalParticleFinishTimer);
    modalParticleFrame = 0;
    modalParticleRevealTimer = 0;
    modalParticleFinishTimer = 0;
    if (activeSourceCard) activeSourceCard.classList.remove('is-disintegrating', 'is-powder-gone', 'is-powder-returning');
    activeSourceCard = null;
    modalMask.classList.remove('is-assembling', 'is-revealing');
    modalParticleContext.clearRect(0, 0, modalParticleCanvas.width, modalParticleCanvas.height);
}

function revealModalAssembly() {
    if (modalMask.classList.contains('is-assembling')) modalMask.classList.add('is-revealing');
}

function finishModalAssembly() {
    if (!modalMask.classList.contains('is-assembling')) return;
    if (modalParticleFrame) cancelAnimationFrame(modalParticleFrame);
    clearTimeout(modalParticleRevealTimer);
    clearTimeout(modalParticleFinishTimer);
    modalParticleFrame = 0;
    modalParticleRevealTimer = 0;
    modalParticleFinishTimer = 0;
    modalMask.classList.add('is-revealing');
    modalMask.classList.remove('is-assembling');
    if (activeSourceCard) {
        activeSourceCard.classList.remove('is-disintegrating');
        activeSourceCard.classList.add('is-powder-gone');
    }
    modalParticleContext.clearRect(0, 0, modalParticleCanvas.width, modalParticleCanvas.height);
}

function animateModalAssembly(sourceCard, item) {
    const viewportWidth = modalMask.clientWidth;
    const viewportHeight = modalMask.clientHeight;
    const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
    modalParticleCanvas.width = Math.round(viewportWidth * pixelRatio);
    modalParticleCanvas.height = Math.round(viewportHeight * pixelRatio);
    modalParticleContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);

    const sourceRect = sourceCard.getBoundingClientRect();
    const targets = makeModalParticleTargets(modalMask.querySelector('.modal'), item);
    if (!targets.length) return;

    const isDark = document.body.dataset.theme === 'dark';
    const colors = isDark
        ? ['#d8e8ff', '#8dbaff', '#ffffff', '#c7d8f7']
        : ['#fff3cc', '#e9c477', '#f7e8bf', '#91b8ef'];
    const particleCount = Math.min(920, Math.max(560, targets.length));
    const particles = Array.from({ length: particleCount }, (_, index) => {
        const targetIndex = Math.floor(index / Math.max(1, particleCount - 1) * (targets.length - 1));
        const target = targets[targetIndex];
        return {
            x: sourceRect.left + Math.random() * sourceRect.width,
            y: sourceRect.top + Math.random() * sourceRect.height,
            targetX: target.x,
            targetY: target.y,
            size: .8 + Math.random() * 1.8,
            delay: index / Math.max(1, particleCount - 1) * 55,
            lift: 10 + Math.random() * 28,
            sway: (Math.random() - .5) * 12,
            phase: Math.random() * Math.PI * 2,
            color: colors[Math.floor(Math.random() * colors.length)]
        };
    });

    activeSourceCard = sourceCard;
    sourceCard.classList.remove('is-entering');
    sourceCard.classList.add('is-disintegrating');
    modalMask.classList.add('is-assembling');
    const startedAt = performance.now();
    const duration = 500;
    const revealAt = 455;
    modalParticleRevealTimer = window.setTimeout(revealModalAssembly, revealAt);
    modalParticleFinishTimer = window.setTimeout(finishModalAssembly, duration);

    function drawFrame(now) {
        const elapsed = now - startedAt;
        modalParticleContext.clearRect(0, 0, viewportWidth, viewportHeight);
        for (const particle of particles) {
            const progress = Math.max(0, Math.min(1, (elapsed - particle.delay) / 400));
            if (!progress) continue;
            const eased = 1 - Math.pow(1 - progress, 3);
            const lift = Math.sin(progress * Math.PI) * particle.lift;
            const sway = Math.sin(progress * Math.PI + particle.phase) * particle.sway;
            const x = particle.x + (particle.targetX - particle.x) * eased + sway;
            const y = particle.y + (particle.targetY - particle.y) * eased - lift;
            const fade = progress > .88 ? Math.max(.32, 1 - (progress - .88) * 3) : .72 + progress * .28;
            modalParticleContext.globalAlpha = fade;
            modalParticleContext.fillStyle = particle.color;
            modalParticleContext.shadowColor = particle.color;
            modalParticleContext.shadowBlur = progress < 1 ? 7 : 2;
            modalParticleContext.beginPath();
            modalParticleContext.arc(x, y, particle.size, 0, Math.PI * 2);
            modalParticleContext.fill();
        }
        modalParticleContext.globalAlpha = 1;
        modalParticleContext.shadowBlur = 0;

        if (elapsed >= revealAt) revealModalAssembly();
        if (elapsed < duration) {
            modalParticleFrame = requestAnimationFrame(drawFrame);
        } else {
            finishModalAssembly();
        }
    }

    modalParticleFrame = requestAnimationFrame(drawFrame);
}

