<!DOCTYPE html>
<html lang="zh-Hans">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aries.zxcvbnm小仓</title>
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; scrollbar-width: none; }
    *::-webkit-scrollbar { display: none; }

    :root {
        --page-bg: #f5f6f8;
        --surface: #fff;
        --surface-hover: #f7f9ff;
        --text: #222;
        --muted: #888;
        --border: #e5e6eb;
        --input-border: #dcdfe6;
        --accent: #0066ff;
    }

    body[data-theme="dark"] {
        --page-bg: #11151d;
        --surface: #1b222d;
        --surface-hover: #232d3a;
        --text: #eef3fb;
        --muted: #9aa8ba;
        --border: #303c4d;
        --input-border: #3a485c;
        --accent: #6ea8ff;
    }

    body {
        font-family: -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif;
        background: radial-gradient(ellipse at bottom, #1b2735 0%, #090a0f 100%);
        color: var(--text);
        min-height: 100vh;
        transition: background .3s ease, color .3s ease;
    }

    body[data-theme="light"] {
        background:
            radial-gradient(ellipse at 50% -12%, rgba(255, 255, 235, .98) 0%, rgba(255, 239, 190, .45) 30%, rgba(255, 239, 190, 0) 62%),
            radial-gradient(ellipse at 72% 88%, rgba(207, 157, 77, .18) 0%, rgba(207, 157, 77, 0) 48%),
            linear-gradient(168deg, #fff0b8 0%, #f2d99b 45%, #dfbb78 100%);
    }

    /* ================= 星空背景层 ================= */
    #starfield {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background: transparent;
        z-index: 0;
        pointer-events: none;
        display: block;
    }

    #desertTexture {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        opacity: .58;
        background:
            radial-gradient(ellipse 78% 34% at 4% 106%, rgba(145, 94, 35, .16), transparent 70%),
            radial-gradient(ellipse 72% 30% at 94% 8%, rgba(255, 250, 205, .28), transparent 70%),
            radial-gradient(circle at 16% 26%, rgba(126, 80, 27, .16) 0 1px, transparent 2px),
            radial-gradient(circle at 78% 68%, rgba(126, 80, 27, .12) 0 1px, transparent 2px),
            radial-gradient(ellipse at 18% 32%, rgba(255, 245, 190, .24), transparent 42%),
            radial-gradient(ellipse at 82% 78%, rgba(130, 81, 30, .12), transparent 38%);
        mix-blend-mode: multiply;
        transition: opacity .3s ease;
    }

    body[data-theme="dark"] #desertTexture {
        opacity: .18;
        mix-blend-mode: screen;
    }

    body[data-effects="off"] #desertTexture { opacity: .4; }
    body[data-theme="light"] #starfield { z-index: 4; }

    header, nav, main, .site-footer, .modal-mask {
        position: relative;
        z-index: 2;
    }

    header {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 14px 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .logo {
        font-size: 18px;
        font-weight: 700;
        color: var(--accent);
        white-space: nowrap;
    }

    .version-label {
        margin-left: -10px;
        color: var(--muted);
        font-size: 11px;
        white-space: nowrap;
    }

    .message-toggle {
        height: 38px;
        padding: 0 11px;
        border: 1px solid var(--input-border);
        border-radius: 6px;
        background: var(--surface);
        color: var(--text);
        font-size: 13px;
        cursor: pointer;
        white-space: nowrap;
        transition: border-color .2s, color .2s;
    }

    .message-toggle:hover { border-color: var(--accent); color: var(--accent); }

    .menu-wrap { position: relative; z-index: 20; }

    .menu-toggle {
        display: grid;
        place-items: center;
        width: 40px;
        height: 38px;
        border: 1px solid var(--input-border);
        border-radius: 6px;
        background: var(--surface);
        color: var(--text);
        font-size: 19px;
        cursor: pointer;
        transition: color .2s, border-color .2s, background .2s;
    }

    .menu-toggle:hover, .menu-toggle[aria-expanded="true"] {
        border-color: var(--accent);
        color: var(--accent);
        background: var(--surface-hover);
    }

    .settings-menu {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        width: min(292px, calc(100vw - 24px));
        padding: 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        box-shadow: 0 18px 44px rgba(10, 18, 30, .22);
        color: var(--text);
    }

    .settings-menu[hidden] { display: none; }
    .settings-menu h3 { margin: 0 0 9px; font-size: 12px; color: var(--muted); }
    .settings-menu .menu-section + .menu-section { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border); }

    .theme-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; }

    .theme-choice, .setting-action {
        min-height: 34px;
        border: 1px solid var(--input-border);
        border-radius: 6px;
        background: var(--surface);
        color: var(--muted);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        transition: color .18s, border-color .18s, background .18s;
    }

    .theme-choice.active, .setting-action.active,
    .theme-choice:hover, .setting-action:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: var(--surface-hover);
    }

    .setting-action { width: 100%; margin-top: 7px; text-align: left; padding: 0 10px; }

    .search-wrap { flex: 1; min-width: 220px; position: relative; }

    .search-wrap input {
        width: 100%;
        height: 38px;
        border: 1px solid var(--input-border);
        border-radius: 6px;
        padding: 0 38px 0 14px;
        font-size: 14px;
        outline: none;
        transition: border-color .2s;
        background: var(--surface);
        color: var(--text);
    }

    .search-wrap input:focus { border-color: var(--accent); }
    .search-wrap input::placeholder { color: var(--muted); }

    .search-wrap .clear-btn {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: none;
        cursor: pointer;
        font-size: 16px;
        color: #999;
        display: none;
    }

    nav {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 0 24px;
        display: flex;
        gap: 4px;
        overflow-x: auto;
        position: sticky;
        top: 67px;
        z-index: 9;
    }

    nav .effect-toggle {
        height: 28px;
        margin: 8px 0 8px auto;
        padding: 0 12px;
        border: 1px solid var(--input-border);
        border-radius: 14px;
        background: var(--surface);
        color: var(--muted);
        cursor: pointer;
        font-size: 12px;
        white-space: nowrap;
        transition: color .2s, border-color .2s, background .2s;
    }

    nav .effect-toggle:hover, nav .effect-toggle.active {
        border-color: var(--accent);
        color: var(--accent);
    }

    nav .effect-toggle.active { background: var(--surface-hover); }
    nav .glass-toggle { margin-left: 0; }

    body[data-card-glass="on"] .row {
        background: rgba(255, 252, 238, .48);
        border-color: rgba(255, 255, 255, .58);
        -webkit-backdrop-filter: blur(14px) saturate(115%);
        backdrop-filter: blur(14px) saturate(115%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .42), 0 12px 26px rgba(105, 67, 24, .14);
    }

    body[data-card-glass="on"] .row:hover {
        background: rgba(255, 252, 238, .62);
        border-color: rgba(255, 255, 255, .78);
    }

    body[data-theme="dark"][data-card-glass="on"] .row {
        background: rgba(27, 34, 45, .58);
        border-color: rgba(255, 255, 255, .22);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .08), 0 12px 26px rgba(0, 0, 0, .2);
    }

    body[data-theme="dark"][data-card-glass="on"] .row:hover {
        background: rgba(35, 45, 58, .72);
        border-color: rgba(255, 255, 255, .42);
    }

    body[data-effects="off"] { background: var(--page-bg); }
    body[data-effects="off"] #starfield { opacity: 0; }

    nav .tab {
        height: 44px;
        line-height: 44px;
        padding: 0 16px;
        font-size: 13px;
        color: var(--muted);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        white-space: nowrap;
        transition: color .2s, border-color .2s;
        user-select: none;
    }

    nav .tab:hover { color: var(--accent); }
    nav .tab.active {
        color: var(--accent);
        border-bottom-color: var(--accent);
        font-weight: 600;
    }

    main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 16px 92px;
    }

    .result-tip { font-size: 13px; color: #888; margin-bottom: 12px; }

    .list-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .list-toolbar .result-tip { margin: 0; }
    .sort-control { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-size: 12px; white-space: nowrap; }

    .sort-control select {
        height: 32px;
        padding: 0 26px 0 9px;
        border: 1px solid var(--input-border);
        border-radius: 6px;
        background: var(--surface);
        color: var(--text);
        font: inherit;
        cursor: pointer;
    }

    .personal-panel[hidden] { display: none !important; }
    .personal-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 12px; }
    .personal-views { display: inline-flex; gap: 4px; }

    .personal-view, .submit-software {
        min-height: 34px;
        padding: 0 12px;
        border: 1px solid var(--input-border);
        border-radius: 6px;
        background: var(--surface);
        color: var(--muted);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        transition: color .18s, border-color .18s, background .18s;
    }

    .personal-view.active, .submit-software:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: var(--surface-hover);
    }

    .personal-view.active { font-weight: 600; }

    @media (max-width: 560px) {
        .list-toolbar { align-items: flex-start; }
        .sort-control { gap: 4px; }
        .sort-control select { max-width: 112px; }
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
        margin: 20px 0 8px;
        padding-left: 4px;
    }

    .list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 12px;
        background: transparent;
        border: none;
        overflow: visible;
    }

    .row {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        aspect-ratio: 3 / 1;
        border: 1px solid #e5e6eb;
        border-radius: 8px;
        background: var(--surface);
        cursor: pointer;
        overflow: hidden;
        transition: background .24s ease, border-color .24s ease, transform .3s cubic-bezier(.2, .8, .2, 1), box-shadow .3s ease;
        z-index: 3;
    }

    .row.is-entering {
        animation: card-in .58s cubic-bezier(.16, 1, .3, 1) both;
    }

    .row::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 8px;
        background: linear-gradient(110deg, transparent 28%, rgba(76, 148, 255, .14) 48%, rgba(255, 255, 255, .3) 52%, transparent 74%);
        opacity: 0;
        transform: translateX(-110%);
        transition: transform .72s cubic-bezier(.2, .65, .3, 1), opacity .18s ease;
        pointer-events: none;
        z-index: 0;
    }

    .row:hover {
        background: var(--surface-hover);
        border-color: var(--accent);
        transform: translateY(-3px);
        box-shadow: 0 12px 26px rgba(25, 44, 75, .16);
    }

    .row:hover::before { opacity: 1; transform: translateX(110%); }

    .row .name { font-size: 14px; color: var(--text); font-weight: 500; }
    .row .name-text { display: inline-block; }
    .rating-dot { display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; vertical-align: 1px; }
    .rating-dot.good { background: #31966a; }
    .rating-dot.medium { background: #d59a23; }
    .rating-dot.low { background: #d94c4c; }
    .rating-dot.neutral { background: #8c929d; }

    .row .match-letter {
        display: inline-block;
        background: rgba(255, 74, 74, .12);
        color: #e53935;
        border-radius: 4px;
        padding: 0 2px;
        font-weight: 700;
        box-shadow: inset 0 0 0 1px rgba(229, 57, 53, .22);
        transform: translateY(-1px);
    }

    .row .name .badge {
        display: inline-block;
        margin-left: 8px;
        font-size: 11px;
        padding: 1px 6px;
        border-radius: 4px;
        background: #ffefef;
        color: #e63946;
        font-weight: 600;
        vertical-align: middle;
    }

    .row .platforms { font-size: 12px; color: var(--muted); margin-left: 10px; }

    .row .action {
        font-size: 13px;
        color: var(--accent);
        font-weight: 600;
        white-space: nowrap;
    }

    .row-actions { display: flex; align-items: center; gap: 8px; flex: none; }

    .favorite-toggle {
        width: 28px;
        height: 30px;
        border: 0;
        background: transparent;
        color: var(--muted);
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
    }

    .favorite-toggle.active { color: #d49421; }
    .favorite-toggle:focus-visible, .official-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    .official-link {
        position: absolute;
        top: 7px;
        right: 10px;
        display: grid;
        place-items: center;
        width: 24px;
        height: 24px;
        border-radius: 5px;
        background: var(--surface);
        color: var(--accent);
        font-size: 16px;
        line-height: 1;
        text-decoration: none;
        opacity: 0;
        transform: translateY(2px);
        transition: opacity .18s, transform .18s;
        z-index: 2;
    }

    .row:hover .official-link, .official-link:focus-visible { opacity: 1; transform: translateY(0); }

    .empty {
        text-align: center;
        color: #999;
        padding: 60px 0;
        font-size: 14px;
    }

    /* ================= 下载弹窗 ================= */
    .modal-mask {
        position: fixed;
        inset: 0;
        background: rgba(44, 34, 18, .22);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 100;
        padding: 20px;
    }

    .modal-mask.show { display: flex; }

    .modal-mask.is-assembling {
        background: rgba(255, 247, 224, .18);
        -webkit-backdrop-filter: blur(2px);
        backdrop-filter: blur(2px);
    }

    body[data-theme="dark"] .modal-mask.is-assembling { background: rgba(6, 10, 18, .3); }

    .modal-particles {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 102;
        opacity: 1;
        pointer-events: none;
        transition: opacity .08s ease;
    }

    .modal-mask.is-assembling .modal {
        visibility: hidden;
        opacity: 0;
        animation: none;
    }

    .modal-mask.is-revealing .modal {
        visibility: visible;
        opacity: 1;
        z-index: 103;
        animation: modal-compose-in .08s cubic-bezier(.2, .8, .2, 1) both;
    }

    .modal-mask.is-revealing .modal-particles { opacity: 0; }

    .download-option[hidden], .download-sources[hidden] { display: none !important; }
    .download-option { margin-bottom: 9px; }
    .download-option .btn { margin-bottom: 4px; }

    .source-links, .download-sources {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 6px 16px;
        min-height: 20px;
        color: var(--muted);
        font-size: 11px;
    }

    .source-links a, .download-sources a {
        color: var(--accent);
        text-decoration: none;
    }

    .source-links a:hover, .download-sources a:hover { text-decoration: underline; }

    .download-source-note {
        margin: 8px 0 5px;
        color: var(--muted);
        font-size: 11px;
        text-align: center;
    }

    .row.is-disintegrating {
        animation: card-dust-vanish .34s ease-in both;
        pointer-events: none;
    }

    .row.is-disintegrating::before { display: none; }

    .row.is-powder-gone { visibility: hidden; opacity: 0; pointer-events: none; }

    .row.is-powder-returning {
        animation: card-powder-return .42s cubic-bezier(.2, .8, .2, 1) both;
        pointer-events: none;
    }

    .modal {
        background: var(--surface);
        border-radius: 12px;
        width: 100%;
        max-width: 420px;
        max-height: 88vh;
        overflow-y: auto;
        padding: 24px;
        position: relative;
        color: var(--text);
        animation: modal-in .24s ease-out;
        z-index: 101;
    }

    .modal h3 { font-size: 17px; margin-bottom: 6px; text-align: center; }

    .modal .sub {
        font-size: 12px;
        color: var(--muted);
        text-align: center;
        margin-bottom: 20px;
    }

    .modal .software-info {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
        margin: 0 0 16px;
        padding: 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--page-bg);
        font-size: 12px;
    }

    .modal .software-info span { color: var(--muted); }
    .modal .software-info strong { color: var(--text); }

    .modal .software-intro {
        margin: 0 0 16px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.7;
        text-align: left;
    }

    .modal .btn {
        position: relative;
        overflow: hidden;
        display: block;
        width: 100%;
        height: 42px;
        line-height: 42px;
        border-radius: 8px;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 5px;
        border: 1px solid var(--input-border);
        background: var(--surface);
        color: var(--text);
        cursor: pointer;
        transition: all .2s;
        isolation: isolate;
    }

    .modal .btn::after {
        content: "";
        position: absolute;
        top: 0;
        left: -60%;
        width: 40%;
        height: 100%;
        background: linear-gradient(120deg,
            rgba(255, 255, 255, 0) 0%,
            rgba(255, 255, 255, .55) 50%,
            rgba(255, 255, 255, 0) 100%);
        transform: skewX(-20deg);
        animation: btn-shine 3.2s ease-in-out infinite;
        pointer-events: none;
        z-index: 1;
    }

    .modal .btn.primary::after {
        background: linear-gradient(120deg,
            rgba(255, 255, 255, 0) 0%,
            rgba(255, 255, 255, .75) 50%,
            rgba(255, 255, 255, 0) 100%);
        animation-duration: 2.4s;
    }

    .modal .btn.primary {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
    }

    .modal .btn:hover { opacity: .88; }
    .modal .btn:hover::after { animation-duration: 1.1s; }

    .modal .btn.disabled {
        background: var(--page-bg);
        color: #bbb;
        cursor: not-allowed;
        border-color: var(--border);
    }

    .modal .btn.disabled::after { display: none; }

    .modal .close {
        position: absolute;
        top: 10px;
        right: 14px;
        border: none;
        background: none;
        font-size: 20px;
        color: #999;
        cursor: pointer;
        z-index: 2;
    }

    .message-modal.modal {
        display: flex;
        flex-direction: column;
        max-width: 560px;
        max-height: 86vh;
        text-align: left;
    }

    .message-modal h3 { margin-bottom: 14px; }

    .message-updates { overflow-y: auto; min-height: 0; }

    .message-update { padding: 12px 0; border-bottom: 1px solid var(--border); }
    .message-update:first-child { padding-top: 0; }
    .message-update time { color: var(--muted); font-size: 11px; }
    .message-update h4 { margin: 4px 0; color: var(--text); font-size: 13px; }
    .message-update p { color: var(--muted); font-size: 12px; line-height: 1.6; }

    .message-compose { padding-top: 14px; }
    .message-compose label { display: block; margin-bottom: 7px; font-size: 13px; font-weight: 600; }
    .message-compose textarea {
        display: block;
        width: 100%;
        min-height: 82px;
        padding: 10px;
        border: 1px solid var(--input-border);
        border-radius: 6px;
        background: var(--surface);
        color: var(--text);
        font: inherit;
        font-size: 13px;
        resize: vertical;
    }

    .message-compose textarea:focus { outline: 1px solid var(--accent); }

    .message-compose-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 10px;
    }

    .message-compose-footer span { color: var(--muted); font-size: 11px; }
    .message-submit { height: 36px; padding: 0 14px; border: 0; border-radius: 6px; background: var(--accent); color: #fff; cursor: pointer; }
    .message-feedback { min-height: 18px; margin-top: 6px; color: var(--muted); font-size: 11px; }

    .theme-toggle {
        height: 38px;
        padding: 0 12px;
        border: 1px solid var(--input-border);
        border-radius: 6px;
        background: var(--surface);
        color: var(--text);
        cursor: pointer;
        white-space: nowrap;
        transition: background .2s, border-color .2s, transform .2s;
    }

    .theme-toggle:hover {
        border-color: var(--accent);
        transform: translateY(-1px);
    }

    .cursor-effect {
        position: fixed;
        left: 0;
        top: 0;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        pointer-events: none;
        opacity: 0;
        z-index: 1;
        transform: translate(-50%, -50%);
        transition: opacity .2s, width .2s, height .2s;
    }

