    let chessState = [];
    let selected = null;
    let lastMove = null;
    let gomokuState = [];
    let goState = [];
    let goCaptures = { black: 0, white: 0 };
    let goUsed = { black: 0, white: 0 };
    let goPasses = 0;
    let previousGoPosition = null;
    let tttState = [];
    let gameOver = false;

    function setGame(nextGame) {
        game = nextGame;
        titleStatus.textContent = gameNames[game];
        tabs.forEach(tab => tab.classList.toggle('active', tab.dataset.game === game));
        sidePrompt.textContent = game === 'ttt' ? '选择你使用的标记' : '选择你执的棋子';
