function setBtn(el, url) {
    const option = el.closest('.download-option');
    if (!url) {
        if (option) option.hidden = true;
        el.removeAttribute('href');
        el.removeAttribute('download');
        el.classList.add('disabled');
        el.setAttribute('aria-disabled', 'true');
        return;
    }

    if (option) option.hidden = false;
    el.href = url;
    el.classList.remove('disabled');
    el.removeAttribute('aria-disabled');
    const isDirectFile = /\.(?:exe|msi|zip|dmg|pkg|7z|appimage|deb|rpm|tar(?:\.gz)?)(?:$|[?#])/i.test(url)
        || /\/download\/(?:win32|win64|mac|windows)(?:[?#]|$)/i.test(url);
    if (isDirectFile) {
        el.setAttribute('download', '');
        el.removeAttribute('target');
    } else {
        el.removeAttribute('download');
        el.target = '_blank';
    }
}

